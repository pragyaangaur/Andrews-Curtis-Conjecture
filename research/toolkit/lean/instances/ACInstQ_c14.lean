import ACPack

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace Q14

open ACBounds ACClosed ACKeys ACPack

/-- the target: the standard pair -/
def stdSt : St := ([ACBounds.la], [ACBounds.lb])

/-- the row -/
def rowSt : St := ([ACBounds.lB, ACBounds.lA, ACBounds.lB, ACBounds.la, ACBounds.lb, ACBounds.la], [ACBounds.lB, ACBounds.lB, ACBounds.lB, ACBounds.la, ACBounds.lB, ACBounds.la, ACBounds.la])

/-- the start state -/
def startSt : St := ([ACBounds.lB, ACBounds.lA, ACBounds.lB, ACBounds.la, ACBounds.lb, ACBounds.la], [ACBounds.lB, ACBounds.lB, ACBounds.lB, ACBounds.la, ACBounds.lB, ACBounds.la, ACBounds.la])

/-- 168 states, 128 fields per chunk, 3 chunks in 2 groups -/
def G0 : List Nat := [
,

]

def G1 : List Nat := [

]

def GS : List (List Nat) := [G0, G1]

def CH : List Nat := GS.flatten

def KEYS : List Nat := (decChunks 128 CH).map keyOf

def T : BTree := bld KEYS

/-- the group checks: one reduction each -/
theorem chk_0 : packCheckC 14 128 T G0 = true := by decide

theorem chk_1 : packCheckC 14 128 T G1 = true := by decide

/-- the assembled closure check -/
theorem chk_T : packCheckC 14 128 T CH = true :=
  packCheckC_flatten 14 128 T GS (by simp [GS, chk_0, chk_1])

/-- the start state is listed -/
theorem mem_T : (decChunks 128 CH).any (fun r => decP r == startSt) = true := by decide

/-- the target is not listed -/
theorem notin_T : (decChunks 128 CH).all (fun r => !(decP r == stdSt)) = true := by decide

/-- **the cap-14 negative** -/
theorem row_T :
    ¬ ∃ ts : List Tok,
        (∀ i, i ≤ ts.length → totLen (run startSt (ts.take i)) ≤ 14) ∧
        run startSt ts = stdSt :=
  not_reach_of_facts (by decide) mem_T notin_T (by simpa [packCheckC, T, KEYS] using chk_T)

end Q14

#print axioms Q14.chk_T
#print axioms Q14.mem_T
#print axioms Q14.row_T
