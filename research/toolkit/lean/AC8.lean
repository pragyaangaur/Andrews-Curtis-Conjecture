/-!
# The Metzler recipe as one theorem over symbolic parameters (round 8, direction K8)

`toolkit/lean/AC7.lean` proved the Metzler family `<x,y | x^k, y^m, [x,y]> ~ <x,y | x^k, y^m,
[x^j,y]>` for 14 concrete parameters, and its *algebra* (`conjProd_of_subst`, `powerProd_spec`,
`powerProd_cert`, `subst_defining`) for all parameters -- but not the statement that a single
uniform move list replays for every `(t, j)` with `k = 1 + t*j`.  This file closes that gap.

`AC8.lean` is generated by `gen_ac8.py` from

* lines 56-292 of `toolkit/lean/AC7.lean` (sha256 `14e0d037fa8e8fd71b1769153fe897e049cd22ae138ae99ec1bbaefef7a6e17c`), copied
  byte for byte -- `QPres`, `QMove`, `QMove.apply`, `replay`, `replay_append`, `replay_concat`,
  `checkCert`, `checkCert_append`;
* `ac8_body.lean`, this round's work.

Nothing here proves or disproves the Andrews-Curtis conjecture.
-/

namespace AC8

abbrev Word (n : Nat) : Type := FreeGroup (Fin n)

/-- A presentation: rank `n`, `m` relators, and the relators themselves.  The Q\*\*-move set does
not preserve balance, and the certificates of `directions/qdouble-star/m9/certs/` are unbalanced
(rank two with one relator, raised to rank three with two relators by the prolongation), so `m` is
kept separate from `n`.  Every Q\*\*-move keeps `n - m` fixed. -/
structure QPres where
  /-- the number of generators -/
  n : Nat
  /-- the number of relators -/
  m : Nat
  /-- the relators -/
  rels : Fin m → Word n

instance : DecidableEq QPres := fun P Q => by
  rcases P with ⟨n, m, r⟩
  rcases Q with ⟨n', m', s⟩
  by_cases h : n = n'
  · subst h
    by_cases h2 : m = m'
    · subst h2
      by_cases h3 : r = s
      · exact isTrue (by rw [h3])
      · exact isFalse (by intro h4; exact h3 (by injection h4))
    · exact isFalse (by intro h4; exact h2 (by injection h4))
  · exact isFalse (by intro h4; exact h (by injection h4))

/-! ## Letter lists, index arithmetic, and the two rank-changing moves -/

/-- The letters of a recorded word, as `(generator index, sign)` pairs, mapped into `Fin n`.
Following `directions/qdouble-star/m9/certs/`, generators are numbered from zero, `true` is the
generator and `false` its inverse.  `none` if a letter is out of range. -/
def mapLetters (n : Nat) : List (Nat × Bool) → Option (List (Fin n × Bool))
  | [] => some []
  | (a, b) :: t =>
    match (if h : a < n then some (⟨a, h⟩, b) else none), mapLetters n t with
    | some x, some l => some (x :: l)
    | _, _ => none

/-- A word of the free group from a recorded letter list, if every letter is in range. -/
def mkWordOpt (n : Nat) (l : List (Nat × Bool)) : Option (Word n) :=
  (mapLetters n l).map FreeGroup.mk

/-- The index in `Fin n` of the `k`-th generator that survives the deletion of `j`: the increasing
bijection `Fin (n-1) → Fin n` whose range is the complement of `{j}`. -/
def skipEmb {n : Nat} (j : Fin n) (k : Fin (n - 1)) : Fin n :=
  if h : k.val < j.val then ⟨k.val, by have hj := j.isLt; omega⟩
  else ⟨k.val + 1, by have hk := k.isLt; have hj := j.isLt; omega⟩

/-- The position of the generator `k` among the survivors of the deletion of `i`; the hypothesis
`k ≠ i` is what makes the value well defined. -/
def skipIndex {n : Nat} (i : Fin n) (k : Fin n) (hk : k ≠ i) : Fin (n - 1) :=
  if h : k.val < i.val then ⟨k.val, by have hi := i.isLt; omega⟩
  else ⟨k.val - 1, by
    have hkk := k.isLt
    have hik : i.val < k.val := by
      rcases Nat.lt_or_ge k.val i.val with hlt | hge
      · exact absurd hlt h
      · rcases Nat.lt_or_eq_of_le hge with hlt | heq
        · exact hlt
        · exact absurd (Fin.ext heq.symm) hk
    omega⟩

/-- Replace the `i`-th relator by `v`. -/
def setRel (P : QPres) (i : Fin P.m) (v : Word P.n) : QPres :=
  ⟨P.n, P.m, fun k => if k = i then v else P.rels k⟩

/-- Apply a letter substitution to every relator.  This is move (iv) for the Nielsen moves. -/
def substRel (P : QPres) (σ : Fin P.n → Word P.n) : QPres :=
  ⟨P.n, P.m, fun k => FreeGroup.lift σ (P.rels k)⟩

/-! ## The Q\*\*-moves -/

/-- One recorded Q\*\*-move.  Indices are zero-based and letter lists are as in the certificate
files of `directions/qdouble-star/m9/certs/`.  Move (vi) carries the conjugating word, which the
converter `gen_ac5.py` reads off the state by cyclic reduction; the checker of the round-4
certificates `directions/qdouble-star/m9/qverify.py` computes the same word, so the information
content of the two formats is the same. -/
inductive QMove where
  /-- (ii) invert a relator -/
  | inv (i : Nat)
  /-- (i) multiply a relator by another on the right, `r_i ↦ r_i r_j` -/
  | mul (i j : Nat)
  /-- (iii) conjugate a relator, `r_i ↦ w r_i w⁻¹` -/
  | conj (i : Nat) (w : List (Nat × Bool))
  /-- (iii) then (i): left multiplication, `r_i ↦ r_j r_i` -/
  | lmul (i j : Nat)
  /-- (iv) `x_i ↦ x_i⁻¹` -/
  | neg (i : Nat)
  /-- (iv) `x_i ↦ x_i x_j` -/
  | nij (i j : Nat)
  /-- (iv) `x_i ↦ x_j x_i` -/
  | nji (i j : Nat)
  /-- (iv) `x_i ↦ x_i x_j⁻¹` -/
  | nijinv (i j : Nat)
  /-- (iv) `x_i ↦ x_j⁻¹ x_i` -/
  | njiinv (i j : Nat)
  /-- (iv) exchange two generators -/
  | swap (i j : Nat)
  /-- (v) adjoin a new generator together with the relator equal to it -/
  | prolong
  /-- (vi) delete the generator `i`, whose relator sits at position `j` and is a conjugate
  `w x_i w⁻¹` -/
  | delete (i j : Nat) (w : List (Nat × Bool))

/-- Apply one recorded move; `none` when the move does not apply to the state.  Every guard is
checked: indices in range, distinct relators for multiplication, letters in range for
conjugation, and for deletion the conjugacy of the deleted relator to the deleted generator. -/
def QMove.apply (m : QMove) (P : QPres) : Option QPres :=
  match m with
  | .inv i =>
    if h : i < P.m then some (setRel P ⟨i, h⟩ (P.rels ⟨i, h⟩)⁻¹) else none
  | .mul i j =>
    if hi : i < P.m then if hj : j < P.m then
      if _hij : i ≠ j then
        some (setRel P ⟨i, hi⟩ (P.rels ⟨i, hi⟩ * P.rels ⟨j, hj⟩)) else none
      else none else none
  | .conj i w =>
    if h : i < P.m then
      match mkWordOpt P.n w with
      | none => none
      | some wk => some (setRel P ⟨i, h⟩ (wk * P.rels ⟨i, h⟩ * wk⁻¹))
    else none
  | .lmul i j =>
    if hi : i < P.m then if hj : j < P.m then
      if _hij : i ≠ j then
        some (setRel P ⟨i, hi⟩ (P.rels ⟨j, hj⟩ * P.rels ⟨i, hi⟩)) else none
      else none else none
  | .neg i =>
    if h : i < P.n then
      let I : Fin P.n := ⟨i, h⟩
      some (substRel P (fun k => if k = I then (FreeGroup.of k)⁻¹ else FreeGroup.of k))
    else none
  | .nij i j =>
    if hi : i < P.n then if hj : j < P.n then
      let I : Fin P.n := ⟨i, hi⟩
      let J : Fin P.n := ⟨j, hj⟩
      some (substRel P (fun k => if k = I then FreeGroup.of k * FreeGroup.of J else FreeGroup.of k))
      else none else none
  | .nji i j =>
    if hi : i < P.n then if hj : j < P.n then
      let I : Fin P.n := ⟨i, hi⟩
      let J : Fin P.n := ⟨j, hj⟩
      some (substRel P (fun k => if k = I then FreeGroup.of J * FreeGroup.of k else FreeGroup.of k))
      else none else none
  | .nijinv i j =>
    if hi : i < P.n then if hj : j < P.n then
      let I : Fin P.n := ⟨i, hi⟩
      let J : Fin P.n := ⟨j, hj⟩
      some (substRel P (fun k => if k = I then FreeGroup.of k * (FreeGroup.of J)⁻¹ else FreeGroup.of k))
      else none else none
  | .njiinv i j =>
    if hi : i < P.n then if hj : j < P.n then
      let I : Fin P.n := ⟨i, hi⟩
      let J : Fin P.n := ⟨j, hj⟩
      some (substRel P (fun k => if k = I then (FreeGroup.of J)⁻¹ * FreeGroup.of k else FreeGroup.of k))
      else none else none
  | .swap i j =>
    if hi : i < P.n then if hj : j < P.n then
      let I : Fin P.n := ⟨i, hi⟩
      let J : Fin P.n := ⟨j, hj⟩
      some (substRel P (fun k => if k = I then FreeGroup.of J else if k = J then FreeGroup.of I else FreeGroup.of k))
      else none else none
  | .prolong =>
    some ⟨P.n + 1, P.m + 1, fun k =>
      Fin.lastCases (FreeGroup.of (Fin.last P.n)) (fun t => FreeGroup.map Fin.castSucc (P.rels t)) k⟩
  | .delete i j w =>
    if hi : i < P.n then if hj : j < P.m then
      let I : Fin P.n := ⟨i, hi⟩
      let J : Fin P.m := ⟨j, hj⟩
      match mkWordOpt P.n w with
      | none => none
      | some wk =>
        if P.rels J = wk * FreeGroup.of I * wk⁻¹ ∨ P.rels J = wk * (FreeGroup.of I)⁻¹ * wk⁻¹ then
          some ⟨P.n - 1, P.m - 1, fun k => FreeGroup.lift
            (fun t => if h : t = I then 1 else FreeGroup.of (skipIndex I t h))
            (P.rels (skipEmb J k))⟩
        else none
    else none else none

/-! ## Replay, the checker, and composition of certificates -/

/-- Replay a list of recorded moves. -/
def replay : List QMove → QPres → Option QPres
  | [], P => some P
  | m :: ms, P => (m.apply P).bind (replay ms)

/-- The certificate checker: replay from the recorded start tuple and compare with the recorded
finish tuple.  This is a `Bool` computed by `decide` in the kernel. -/
def checkCert (ms : List QMove) (start finish : QPres) : Bool :=
  decide (replay ms start = some finish)

/-- Replaying a concatenation: the first block reaches an intermediate tuple and the second
carries on from it. -/
theorem replay_append : ∀ (ms₁ ms₂ : List QMove) (P R : QPres),
    replay ms₁ P = some R → replay (ms₁ ++ ms₂) P = replay ms₂ R
  | [], ms₂, P, R, h => by
      have h' : P = R := by simpa [replay] using h
      rw [h']
      rfl
  | m :: ms₁, ms₂, P, R, h => by
      cases hstep : m.apply P with
      | none => simp [replay, hstep] at h
      | some P' =>
          have hrest : replay ms₁ P' = some R := by simpa [replay, hstep] using h
          rw [List.cons_append, replay, hstep]
          exact replay_append ms₁ ms₂ P' R hrest

/-- Two consecutive replays compose: the composite move list replays from the first start to the
last finish. -/
theorem replay_concat : ∀ (ms₁ ms₂ : List QMove) (P R S : QPres),
    replay ms₁ P = some R → replay ms₂ R = some S → replay (ms₁ ++ ms₂) P = some S
  | [], ms₂, P, R, S, h₁, h₂ => by
      have h : P = R := by simpa [replay] using h₁
      rw [h]
      exact h₂
  | m :: ms₁, ms₂, P, R, S, h₁, h₂ => by
      cases hstep : m.apply P with
      | none => simp [replay, hstep] at h₁
      | some P' =>
          have hrest : replay ms₁ P' = some R := by simpa [replay, hstep] using h₁
          rw [List.cons_append, replay, hstep]
          exact replay_concat ms₁ ms₂ P' R S hrest h₂

/-- **Certificates compose.**  A block checked from `start` to `mid` and a block checked from
`mid` to `finish` give a certificate for the concatenation.  This is what lets a long chain be
checked as several kernel computations, each of them a separate `decide`. -/
theorem checkCert_append {ms₁ ms₂ : List QMove} {start mid finish : QPres}
    (h₁ : checkCert ms₁ start mid = true) (h₂ : checkCert ms₂ mid finish = true) :
    checkCert (ms₁ ++ ms₂) start finish = true := by
  have h₁' : replay ms₁ start = some mid := of_decide_eq_true h₁
  have h₂' : replay ms₂ mid = some finish := of_decide_eq_true h₂
  have h3 : replay (ms₁ ++ ms₂) start = replay ms₂ mid := replay_append ms₁ ms₂ start mid h₁'
  have h4 : replay (ms₁ ++ ms₂) start = some finish := by rw [h3, h₂']
  rw [checkCert, h4]
  simp

set_option linter.unusedSimpArgs false

/-! ## Round 8: the recipe over symbolic parameters -/

/-- The free group on three generators, for the prolongation step. -/
abbrev F3 := FreeGroup (Fin 3)

/-- The free group on two generators. -/
abbrev F2 := FreeGroup (Fin 2)

def x3 : F3 := FreeGroup.of 0
def y3 : F3 := FreeGroup.of 1
def a3 : F3 := FreeGroup.of 2
def x2 : F2 := FreeGroup.of 0
def y2 : F2 := FreeGroup.of 1

/-- `upd f i v` is `f` with the value at `i` replaced by `v`.  Deliberately *not*
`Function.update`: this shape is syntactically the third field of `setRel`, so states built with
it are definitionally the states `QMove.apply` produces.  (Round 7's stage-2 attempt died exactly
on the mismatch between `Function.update`'s dependent `if` and `setRel`'s plain one; see
`directions/lean-program-7/stage2_attempt.md`.) -/
def upd {n m : Nat} (f : Fin m → Word n) (i : Fin m) (v : Word n) : Fin m → Word n :=
  fun k => if k = i then v else f k

theorem setRel_upd {n m : Nat} (r : Fin m → Word n) (i : Fin m) (v : Word n) :
    setRel ⟨n, m, r⟩ i v = ⟨n, m, upd r i v⟩ := rfl

/-- A rank-3, four-relator state, as a function. -/
abbrev st4 (r : Fin 4 → Word 3) : QPres := ⟨3, 4, r⟩

/-- A rank-2, three-relator state, as a function. -/
abbrev st2 (r : Fin 3 → Word 2) : QPres := ⟨2, 3, r⟩

/-- The relator tuple `(r₀,r₁,r₂,r₃)` of a rank-3 state. -/
def q4f (r0 r1 r2 r3 : Word 3) : Fin 4 → Word 3 :=
  fun i => if i = 0 then r0 else if i = 1 then r1 else if i = 2 then r2 else r3

/-- The relator tuple `(r₀,r₁,r₂)` of a rank-2 state. -/
def q2f (r0 r1 r2 : Word 2) : Fin 3 → Word 2 :=
  fun i => if i = 0 then r0 else if i = 1 then r1 else r2

abbrev q4 (r0 r1 r2 r3 : Word 3) : QPres := st4 (q4f r0 r1 r2 r3)
abbrev q2 (r0 r1 r2 : Word 2) : QPres := st2 (q2f r0 r1 r2)

theorem q4f_0 (a b c d : Word 3) : q4f a b c d 0 = a := by
  simp [q4f]

theorem q4f_1 (a b c d : Word 3) : q4f a b c d 1 = b := by
  simp [q4f]

theorem q4f_2 (a b c d : Word 3) : q4f a b c d 2 = c := by
  simp [q4f]

theorem q4f_3 (a b c d : Word 3) : q4f a b c d 3 = d := by
  simp [q4f]

theorem q2f_0 (a b c : Word 2) : q2f a b c 0 = a := by
  simp [q2f]

theorem q2f_1 (a b c : Word 2) : q2f a b c 1 = b := by
  simp [q2f]

theorem q2f_2 (a b c : Word 2) : q2f a b c 2 = c := by
  simp [q2f]

theorem q4f_congr {a b c d a' b' c' d' : Word 3}
    (h0 : a = a') (h1 : b = b') (h2 : c = c') (h3 : d = d') :
    q4f a b c d = q4f a' b' c' d' := by rw [h0, h1, h2, h3]

theorem q2f_congr {a b c a' b' c' : Word 2} (h0 : a = a') (h1 : b = b') (h2 : c = c') :
    q2f a b c = q2f a' b' c' := by rw [h0, h1, h2]

theorem upd_q4f_0 (a b c d v : Word 3) : upd (q4f a b c d) 0 v = q4f v b c d := by
  funext i; fin_cases i <;> simp [upd, q4f]

theorem upd_q4f_1 (a b c d v : Word 3) : upd (q4f a b c d) 1 v = q4f a v c d := by
  funext i; fin_cases i <;> simp [upd, q4f]

theorem upd_q4f_2 (a b c d v : Word 3) : upd (q4f a b c d) 2 v = q4f a b v d := by
  funext i; fin_cases i <;> simp [upd, q4f]

theorem upd_q4f_3 (a b c d v : Word 3) : upd (q4f a b c d) 3 v = q4f a b c v := by
  funext i; fin_cases i <;> simp [upd, q4f]

theorem upd_q2f_0 (a b c v : Word 2) : upd (q2f a b c) 0 v = q2f v b c := by
  funext i; fin_cases i <;> simp [upd, q2f]

theorem upd_q2f_1 (a b c v : Word 2) : upd (q2f a b c) 1 v = q2f a v c := by
  funext i; fin_cases i <;> simp [upd, q2f]

theorem upd_q2f_2 (a b c v : Word 2) : upd (q2f a b c) 2 v = q2f a b v := by
  funext i; fin_cases i <;> simp [upd, q2f]

/-- The letter list of a word: the certificate format's name for a conjugating word. -/
def lettersOf {n : Nat} (w : Word n) : List (Nat × Bool) :=
  (FreeGroup.toWord w).map (fun p : Fin n × Bool => (p.1.val, p.2))

theorem mapLetters_lettersOf {n : Nat} (w : Word n) :
    mapLetters n (lettersOf w) = some (FreeGroup.toWord w) := by
  unfold lettersOf
  generalize FreeGroup.toWord w = L
  clear w
  induction L with
  | nil => rfl
  | cons p t ih =>
    obtain ⟨a, b⟩ := p
    simp only [List.map_cons, mapLetters, a.isLt, dif_pos, ih]

theorem mkWordOpt_lettersOf {n : Nat} (w : Word n) : mkWordOpt n (lettersOf w) = some w := by
  unfold mkWordOpt
  rw [mapLetters_lettersOf]
  simp [FreeGroup.mk_toWord]

/-- The presentation `<x,y | y^m, [x^j,y], x^k>`.  This is `AC7.metz k m j` with the three
relators in the order `(y^m, [x^j,y], x^k)` instead of `(x^k, y^m, [x^j,y])`: the same
presentation, a different relator list.  The order is forced by the recipe's endgame, and
`QMove` has no relator-permutation move. -/
def metz (k m j : Nat) : QPres :=
  q2 (y2 ^ m) (x2 ^ j * y2 * (x2 ^ j)⁻¹ * y2⁻¹) (x2 ^ k)

/-- A one-move replay is the move itself. -/
theorem replay_single (mv : QMove) (P : QPres) : replay [mv] P = mv.apply P := by
  cases h : mv.apply P with
  | none => simp [replay, h]
  | some Q => simp [replay, h]

/-! ### The rank-preserving moves, with literal indices -/

theorem ap4_inv_1 (r : Fin 4 → Word 3) :
    QMove.apply (.inv 1) (st4 r) = some (st4 (upd r 1 (r 1)⁻¹)) := rfl

theorem ap4_inv_2 (r : Fin 4 → Word 3) :
    QMove.apply (.inv 2) (st4 r) = some (st4 (upd r 2 (r 2)⁻¹)) := rfl

theorem ap4_mul_23 (r : Fin 4 → Word 3) :
    QMove.apply (.mul 2 3) (st4 r) = some (st4 (upd r 2 (r 2 * r 3))) := rfl

theorem ap4_mul_32 (r : Fin 4 → Word 3) :
    QMove.apply (.mul 3 2) (st4 r) = some (st4 (upd r 3 (r 3 * r 2))) := rfl

theorem ap4_mul_12 (r : Fin 4 → Word 3) :
    QMove.apply (.mul 1 2) (st4 r) = some (st4 (upd r 1 (r 1 * r 2))) := rfl

theorem ap4_conj_1 (r : Fin 4 → Word 3) (w : Word 3) :
    QMove.apply (.conj 1 (lettersOf w)) (st4 r) = some (st4 (upd r 1 (w * r 1 * w⁻¹))) := by
  simp only [QMove.apply, mkWordOpt_lettersOf]
  rfl

theorem ap4_conj_2 (r : Fin 4 → Word 3) (w : Word 3) :
    QMove.apply (.conj 2 (lettersOf w)) (st4 r) = some (st4 (upd r 2 (w * r 2 * w⁻¹))) := by
  simp only [QMove.apply, mkWordOpt_lettersOf]
  rfl

theorem ap4_conj_3 (r : Fin 4 → Word 3) (w : Word 3) :
    QMove.apply (.conj 3 (lettersOf w)) (st4 r) = some (st4 (upd r 3 (w * r 3 * w⁻¹))) := by
  simp only [QMove.apply, mkWordOpt_lettersOf]
  rfl

theorem ap2_inv_1 (r : Fin 3 → Word 2) :
    QMove.apply (.inv 1) (st2 r) = some (st2 (upd r 1 (r 1)⁻¹)) := rfl

theorem ap2_conj_1 (r : Fin 3 → Word 2) (w : Word 2) :
    QMove.apply (.conj 1 (lettersOf w)) (st2 r) = some (st2 (upd r 1 (w * r 1 * w⁻¹))) := by
  simp only [QMove.apply, mkWordOpt_lettersOf]
  rfl

/-! ### The multiplication-by-a-conjugate block

`conj s w ; mul i s ; conj s w⁻¹` multiplies relator `i` by the conjugate `w r_s w⁻¹` and leaves
the other relators alone.  This is the only relator-level pattern the recipe uses. -/

theorem blk23 (a b c d w : Word 3) :
    replay [.conj 3 (lettersOf w), .mul 2 3, .conj 3 (lettersOf w⁻¹)] (q4 a b c d)
      = some (q4 a b (c * (w * d * w⁻¹)) (w⁻¹ * (w * d * w⁻¹) * w)) := by
  simp only [replay, q4, ap4_conj_3, ap4_mul_23, upd_q4f_3, upd_q4f_2,
    q4f_0, q4f_1, q4f_2, q4f_3, inv_inv, Option.bind_some]

theorem blk32 (a b c d w : Word 3) :
    replay [.conj 2 (lettersOf w), .mul 3 2, .conj 2 (lettersOf w⁻¹)] (q4 a b c d)
      = some (q4 a b (w⁻¹ * (w * c * w⁻¹) * w) (d * (w * c * w⁻¹))) := by
  simp only [replay, q4, ap4_conj_2, ap4_mul_32, upd_q4f_2, upd_q4f_3,
    q4f_0, q4f_1, q4f_2, q4f_3, inv_inv, Option.bind_some]

theorem blk12 (a b c d w : Word 3) :
    replay [.conj 2 (lettersOf w), .mul 1 2, .conj 2 (lettersOf w⁻¹)] (q4 a b c d)
      = some (q4 a (b * (w * c * w⁻¹)) (w⁻¹ * (w * c * w⁻¹) * w) d) := by
  simp only [replay, q4, ap4_conj_2, ap4_mul_12, upd_q4f_2, upd_q4f_1,
    q4f_0, q4f_1, q4f_2, q4f_3, inv_inv, Option.bind_some]

/-! ### Lifting the rank-2 presentation to rank 3

`prolong` adds the generator `of (Fin.last 2)` with relator itself, and carries the old relators
along by `FreeGroup.map Fin.castSucc`. -/

/-- The embedding of the rank-2 free group into the rank-3 one used by `prolong`. -/
def emb (w : Word 2) : Word 3 := FreeGroup.map Fin.castSucc w

theorem emb_x : emb x2 = x3 := by
  simp only [emb, x2, x3, FreeGroup.map.of]
  rfl

theorem emb_y : emb y2 = y3 := by
  simp only [emb, y2, y3, FreeGroup.map.of]
  rfl

theorem emb_mul (a b : Word 2) : emb (a * b) = emb a * emb b := map_mul _ a b
theorem emb_inv (a : Word 2) : emb a⁻¹ = (emb a)⁻¹ := map_inv _ a
theorem emb_pow (a : Word 2) (n : Nat) : emb (a ^ n) = (emb a) ^ n := map_pow _ a n

/-- The commutator relator `[x,y]` at rank 3. -/
def com3 : Word 3 := x3 * y3 * x3⁻¹ * y3⁻¹

/-- The commutator relator `[x,y]` at rank 2. -/
def com2 : Word 2 := x2 * y2 * x2⁻¹ * y2⁻¹

theorem emb_com : emb com2 = com3 := by
  simp only [com2, com3, emb_mul, emb_inv, emb_x, emb_y]

theorem emb_y_pow (m : Nat) : emb (y2 ^ m) = y3 ^ m := by
  rw [emb_pow, emb_y]

theorem emb_x_pow (k : Nat) : emb (x2 ^ k) = x3 ^ k := by
  rw [emb_pow, emb_x]

/-- The state `prolong` produces from `metz k m 1`, written out. -/
abbrev prolongRes (k m : Nat) : QPres :=
  ⟨3, 4, fun i => Fin.lastCases (FreeGroup.of (Fin.last 2))
    (fun t => FreeGroup.map Fin.castSucc ((metz k m 1).rels t)) i⟩

theorem prolong_metz (k m : Nat) :
    replay [.prolong] (metz k m 1) = some (prolongRes k m) := rfl

theorem prolongRes_0 (k m : Nat) : (prolongRes k m).rels (0 : Fin 4) = y3 ^ m := by
  have : (prolongRes k m).rels (0 : Fin 4) = emb (y2 ^ m) := rfl
  rw [this, emb_y_pow]

theorem prolongRes_1 (k m : Nat) : (prolongRes k m).rels (1 : Fin 4) = com3 := by
  have : (prolongRes k m).rels (1 : Fin 4) = emb com2 := rfl
  rw [this, emb_com]

theorem prolongRes_2 (k m : Nat) : (prolongRes k m).rels (2 : Fin 4) = x3 ^ k := by
  have : (prolongRes k m).rels (2 : Fin 4) = emb (x2 ^ k) := rfl
  rw [this, emb_x_pow]

theorem prolongRes_3 (k m : Nat) : (prolongRes k m).rels (3 : Fin 4) = a3 := rfl

theorem prolong_metz_clean (k m : Nat) :
    replay [.prolong] (metz k m 1) = some (q4 (y3 ^ m) com3 (x3 ^ k) a3) := by
  rw [prolong_metz]
  have e : (prolongRes k m).rels = q4f (y3 ^ m) com3 (x3 ^ k) a3 := by
    funext i
    fin_cases i
    · exact prolongRes_0 k m
    · exact prolongRes_1 k m
    · exact prolongRes_2 k m
    · exact prolongRes_3 k m
  have h : prolongRes k m = q4 (y3 ^ m) com3 (x3 ^ k) a3 := by
    rw [show prolongRes k m = (⟨3, 4, (prolongRes k m).rels⟩ : QPres) from rfl, e]
  rw [h]

/-! ### The generalized prolongation `a ↦ a x⁻¹`

`nijinv 2 0` substitutes the new generator `a` by `a x⁻¹`; applied `t` times it turns the relator
`a` into `a x⁻ᵗ`.  This is Barmak's generalized prolongation, realised with the Nielsen move the
`QMove` set has. -/

/-- The substitution of move `.nijinv 2 0`. -/
def s20 : Fin 3 → Word 3 :=
  fun k => if k = 2 then FreeGroup.of k * (FreeGroup.of 0)⁻¹ else FreeGroup.of k

theorem s20_0 : s20 0 = x3 := by simp [s20, x3]

theorem s20_1 : s20 1 = y3 := by simp [s20, y3]

theorem s20_2 : s20 2 = a3 * x3⁻¹ := by simp [s20, a3, x3]

/-- The Nielsen move `.nijinv 2 0` is the endomorphism `s20` applied to every relator. -/
theorem ap4_nijinv_20 (r : Fin 4 → Word 3) :
    QMove.apply (.nijinv 2 0) (st4 r)
      = some (⟨3, 4, fun k => FreeGroup.lift s20 (r k)⟩ : QPres) := rfl

/-- A free-group homomorphism acts on a relator tuple entrywise. -/
theorem q4f_map (F : Word 3 →* Word 3) (a b c d : Word 3) :
    (fun k => F (q4f a b c d k)) = q4f (F a) (F b) (F c) (F d) := by
  funext k
  fin_cases k <;> simp [q4f]

theorem lift_s20_y_pow (m : Nat) : FreeGroup.lift s20 (y3 ^ m) = y3 ^ m := by
  rw [map_pow, show FreeGroup.lift s20 y3 = y3 by
    simp only [y3, FreeGroup.lift_apply_of, s20_1]]

theorem lift_s20_x_pow (k : Nat) : FreeGroup.lift s20 (x3 ^ k) = x3 ^ k := by
  rw [map_pow, show FreeGroup.lift s20 x3 = x3 by
    simp only [x3, FreeGroup.lift_apply_of, s20_0]]

theorem lift_s20_com3 : FreeGroup.lift s20 com3 = com3 := by
  simp only [com3, map_mul, map_inv, x3, y3, FreeGroup.lift_apply_of, s20_0, s20_1]

/-- `FreeGroup.lift s20` fixes `a3` up to the exponent shift. -/
theorem lift_s20_a3 : FreeGroup.lift s20 a3 = a3 * x3 ^ (-(1 : ℤ)) := by
  simp only [a3, x3, FreeGroup.lift_apply_of, s20_2]
  rw [zpow_neg_one]

theorem lift_s20_x3 : FreeGroup.lift s20 x3 = x3 := by
  simp only [x3, FreeGroup.lift_apply_of, s20_0]

/-- One generalized-prolongation step: the relator `a x⁻ˢ` becomes `a x⁻⁽ˢ⁺¹⁾`. -/
theorem nijinv_step (m k s : Nat) :
    replay [.nijinv 2 0] (q4 (y3 ^ m) com3 (x3 ^ k) (a3 * x3 ^ (-(s : ℤ))))
      = some (q4 (y3 ^ m) com3 (x3 ^ k) (a3 * x3 ^ (-((s + 1 : Nat) : ℤ)))) := by
  rw [replay_single, ap4_nijinv_20]
  have h3 : FreeGroup.lift s20 (a3 * x3 ^ (-(s : ℤ)))
      = a3 * x3 ^ (-((s + 1 : Nat) : ℤ)) := by
    rw [map_mul, map_zpow, lift_s20_a3, lift_s20_x3, mul_assoc, ← zpow_add]
    congr 1
    push_cast
    ring
  have h : (⟨3, 4, fun j => FreeGroup.lift s20
        (q4f (y3 ^ m) com3 (x3 ^ k) (a3 * x3 ^ (-(s : ℤ))) j)⟩ : QPres)
      = q4 (y3 ^ m) com3 (x3 ^ k) (a3 * x3 ^ (-((s + 1 : Nat) : ℤ))) := by
    rw [q4f_map]
    rw [q4f_congr (lift_s20_y_pow m) lift_s20_com3 (lift_s20_x_pow k) h3]
  rw [h]

/-! ### The three parametric phases -/

/-- Replaying a move and then a list. -/
theorem replay_cons {mv : QMove} {ms : List QMove} {P Q : QPres}
    (h : mv.apply P = some Q) : replay (mv :: ms) P = replay ms Q := by
  simp [replay, h]

/-- `t` generalized prolongation steps: the relator `a` becomes `a x⁻ᵗ`. -/
theorem nijinv_iter (m k : Nat) : ∀ t s : Nat,
    replay (List.replicate t (.nijinv 2 0))
        (q4 (y3 ^ m) com3 (x3 ^ k) (a3 * x3 ^ (-(s : ℤ)))) =
      some (q4 (y3 ^ m) com3 (x3 ^ k) (a3 * x3 ^ (-((s + t : Nat) : ℤ)))) := by
  intro t
  induction t with
  | zero => intro s; simp [replay]
  | succ n ih =>
    intro s
    rw [List.replicate_succ, replay_cons (by rw [← replay_single]; exact nijinv_step m k s),
      ih (s + 1), Nat.add_assoc, Nat.add_comm 1 n]

/-! #### Stage 2: multiply `x^k` by `j` conjugates of `a x⁻ᵗ` to get `x aʲ` -/

/-- The target relator during stage 2: after `s` of the `j` multiplications it is
`x aˢ x^(t(j−s))`. -/
def s2c (t j s : Nat) : Word 3 := x3 * a3 ^ (s : ℤ) * x3 ^ (((t * (j - s) : Nat)) : ℤ)

/-- The scratch relator during stage 2: `a x⁻ᵗ`. -/
def s2d (t : Nat) : Word 3 := a3 * x3 ^ (-(t : ℤ))

/-- The conjugating word of the `s`-th stage-2 block: `x^(−t(j−s))`. -/
def s2w (t j s : Nat) : Word 3 := x3 ^ (-(((t * (j - s) : Nat)) : ℤ))

abbrev PA (m k t j s : Nat) : QPres := q4 (y3 ^ m) com3 (s2c t j s) (s2d t)

theorem stage2_base (m k t j : Nat) (hk : k = 1 + t * j) :
    q4 (y3 ^ m) com3 (x3 ^ k) (s2d t) = PA m k t j 0 := by
  have hx : x3 ^ k = s2c t j 0 := by
    simp only [s2c, Nat.sub_zero]
    rw [← zpow_natCast, Nat.cast_mul, hk, Nat.cast_add, Nat.cast_one, Nat.cast_mul,
      zpow_add, zpow_one, Nat.cast_zero, zpow_zero, mul_one]
  rw [hx]

theorem stage2_step (m k t j s : Nat) (hs : s < j) :
    replay [.conj 3 (lettersOf (s2w t j s)), .mul 2 3, .conj 3 (lettersOf ((s2w t j s)⁻¹))]
      (PA m k t j s) = some (PA m k t j (s + 1)) := by
  have h2 : s2c t j s * (s2w t j s * s2d t * (s2w t j s)⁻¹) = s2c t j (s + 1) := by
    simp only [s2c, s2d, s2w]
    have hA : (((t * (j - (s + 1)) : Nat)) : ℤ) = (((t * (j - s) : Nat)) : ℤ) - (t : ℤ) := by
      have hjs : j - s = (j - (s + 1)) + 1 := by
        rw [Nat.sub_succ]
        exact (Nat.succ_pred_eq_of_pos (Nat.sub_pos_of_lt hs)).symm
      rw [hjs]; push_cast; ring
    rw [hA]
    group
  have h3 : (s2w t j s)⁻¹ * (s2w t j s * s2d t * (s2w t j s)⁻¹) * s2w t j s = s2d t := by
    group
  rw [blk23, h2, h3]

/-- The stage-2 move list for `s` blocks. -/
def stage2Ms (t j : Nat) : Nat → List QMove
  | 0 => []
  | (s + 1) => stage2Ms t j s ++
      [.conj 3 (lettersOf (s2w t j s)), .mul 2 3, .conj 3 (lettersOf ((s2w t j s)⁻¹))]

theorem stage2_iter (m k t j : Nat) : ∀ s, s ≤ j →
    replay (stage2Ms t j s) (PA m k t j 0) = some (PA m k t j s)
  | 0, _ => by simp [stage2Ms, replay]
  | (s + 1), hs => by
    rw [stage2Ms,
      replay_concat (stage2Ms t j s) _ _ _ _ (stage2_iter m k t j s (Nat.le_of_succ_le hs))
        (stage2_step m k t j s (Nat.lt_of_succ_le hs))]

/-! #### Phase 3: `a x⁻ᵗ` becomes `a^k`, by the multiplier `xᵗ a^(tj)` -/

/-- The scratch relator during phase 3: after `s` blocks it is `a x^(−(t−s)) a^(sj)`. -/
def s3d (t j s : Nat) : Word 3 := a3 * x3 ^ (-(((t - s : Nat)) : ℤ)) * a3 ^ (((s * j : Nat)) : ℤ)

/-- The conjugating word of the `s`-th phase-3 block: `a^(−sj)`. -/
def s3w (t j s : Nat) : Word 3 := a3 ^ (-(((s * j : Nat)) : ℤ))

abbrev PD (m k t j s : Nat) : QPres := q4 (y3 ^ m) com3 (s2c t j j) (s3d t j s)

theorem phaseD3_base (m k t j : Nat) :
    q4 (y3 ^ m) com3 (s2c t j j) (s2d t) = PD m k t j 0 := by
  have h : s2d t = s3d t j 0 := by simp [s2d, s3d]
  rw [h]

theorem phaseD3_step (m k t j s : Nat) (hs : s < t) :
    replay [.conj 2 (lettersOf (s3w t j s)), .mul 3 2, .conj 2 (lettersOf ((s3w t j s)⁻¹))]
      (PD m k t j s) = some (PD m k t j (s + 1)) := by
  have h3 : s3d t j s * (s3w t j s * s2c t j j * (s3w t j s)⁻¹) = s3d t j (s + 1) := by
    simp only [s3d, s3w, s2c]
    have hA : -(((t - (s + 1) : Nat)) : ℤ) = -(((t - s : Nat)) : ℤ) + 1 := by
      have hts : t - s = (t - (s + 1)) + 1 := by
        rw [Nat.sub_succ]
        exact (Nat.succ_pred_eq_of_pos (Nat.sub_pos_of_lt hs)).symm
      rw [hts]; push_cast; ring
    rw [hA]
    group
  have h2 : (s3w t j s)⁻¹ * (s3w t j s * s2c t j j * (s3w t j s)⁻¹) * s3w t j s
      = s2c t j j := by group
  rw [blk32, h2, h3]

def phaseD3Ms (t j : Nat) : Nat → List QMove
  | 0 => []
  | (s + 1) => phaseD3Ms t j s ++
      [.conj 2 (lettersOf (s3w t j s)), .mul 3 2, .conj 2 (lettersOf ((s3w t j s)⁻¹))]

theorem phaseD3_iter (m k t j : Nat) : ∀ s, s ≤ t →
    replay (phaseD3Ms t j s) (PD m k t j 0) = some (PD m k t j s)
  | 0, _ => by simp [phaseD3Ms, replay]
  | (s + 1), hs => by
    rw [phaseD3Ms,
      replay_concat (phaseD3Ms t j s) _ _ _ _ (phaseD3_iter m k t j s (Nat.le_of_succ_le hs))
        (phaseD3_step m k t j s (Nat.lt_of_succ_le hs))]

/-! #### Phase 4: `[x,y]` becomes `[a⁻ʲ,y]` -/

/-- Round 6's `V⁻¹` for `V = [x,y]`. -/
def d2v1 : Word 3 := y3 * x3 * y3⁻¹ * x3⁻¹

/-- `(xy)⁻¹ · [x,y]`. -/
def d2v2 : Word 3 := y3 * x3

def d2Ms : List QMove :=
  [.inv 2, .conj 2 (lettersOf d2v1), .mul 1 2, .conj 2 (lettersOf d2v1⁻¹),
   .inv 2, .conj 2 (lettersOf d2v2), .mul 1 2, .conj 2 (lettersOf d2v2⁻¹)]

/-- A conjugation followed by its inverse cancels. -/
@[simp] theorem inv_conj_cancel {G : Type} [Group G] (w x : G) :
    w⁻¹ * (w * x * w⁻¹) * w = x := by group

/-- Phase 4: `[x,y]` becomes `[a⁻ʲ,y]`, multiplying by conjugates of the relator `c`. -/
theorem phaseD2 (A B c D : Word 3) :
    replay d2Ms (q4 A B c D)
      = some (q4 A (B * (d2v1 * c⁻¹ * d2v1⁻¹) * (d2v2 * c * d2v2⁻¹)) c D) := by
  simp only [d2Ms, replay, ap4_inv_2, ap4_conj_2, ap4_mul_12, q4f_0, q4f_1, q4f_2, q4f_3,
    upd_q4f_1, upd_q4f_2, upd_q4f_3, inv_conj_cancel, inv_inv, Option.bind_some]

/-- The rank-2 version of `q4f_map`. -/
theorem q2f_map (F : Word 2 →* Word 2) (a b c : Word 2) :
    (fun k => F (q2f a b c k)) = q2f (F a) (F b) (F c) := by
  funext k
  fin_cases k <;> simp [q2f]

theorem ap2_inv_2 (r : Fin 3 → Word 2) :
    QMove.apply (.inv 2) (st2 r) = some (st2 (upd r 2 (r 2)⁻¹)) := rfl

theorem upd_q2f_1' (a b c v : Word 2) : upd (q2f a b c) 1 v = q2f a v c := upd_q2f_1 a b c v

/-! #### Phase 5: the Nielsen move `x ↦ x a⁻¹`, `j` times -/

def s02 : Fin 3 → Word 3 :=
  fun k => if k = 0 then FreeGroup.of k * (FreeGroup.of 2)⁻¹ else FreeGroup.of k

theorem s02_0 : s02 0 = x3 * a3⁻¹ := by simp [s02, x3, a3]
theorem s02_1 : s02 1 = y3 := by simp [s02, y3]
theorem s02_2 : s02 2 = a3 := by simp [s02, a3]

theorem ap4_nijinv_02 (r : Fin 4 → Word 3) :
    QMove.apply (.nijinv 0 2) (st4 r)
      = some (⟨3, 4, fun k => FreeGroup.lift s02 (r k)⟩ : QPres) := rfl

theorem lift_s02_x3 : FreeGroup.lift s02 x3 = x3 * a3⁻¹ := by
  simp only [x3, a3, FreeGroup.lift_apply_of, s02_0]

theorem lift_s02_y_pow (m : Nat) : FreeGroup.lift s02 (y3 ^ m) = y3 ^ m := by
  rw [map_pow, show FreeGroup.lift s02 y3 = y3 by
    simp only [y3, FreeGroup.lift_apply_of, s02_1]]

theorem lift_s02_a_pow (k : Nat) : FreeGroup.lift s02 (a3 ^ k) = a3 ^ k := by
  rw [map_pow, show FreeGroup.lift s02 a3 = a3 by
    simp only [a3, FreeGroup.lift_apply_of, s02_2]]

/-- The relator `[x,y]` after phase 4: `a⁻ʲ y x aʲ x⁻¹ y⁻¹`.  It is invariant under the Nielsen
substitution `x ↦ x a⁻¹`, and `delete` carries it to `[x⁻ʲ,y]`. -/
def SL1 (j : Nat) : Word 3 := a3 ^ (-(j : ℤ)) * y3 * x3 * a3 ^ (j : ℤ) * x3⁻¹ * y3⁻¹

/-- `delete`'s image of `SL1 j`. -/
def SL2 (j : Nat) : Word 2 := y2 ^ (-(j : ℤ)) * x2 * y2 ^ (j : ℤ) * x2⁻¹

theorem lift_s02_slot1 (j : Nat) : FreeGroup.lift s02 (SL1 j) = SL1 j := by
  simp only [SL1, map_mul, map_inv, map_zpow, x3, y3, a3, FreeGroup.lift_apply_of,
    s02_0, s02_1, s02_2]
  group

/-- The relator tuple during phase 5. -/
abbrev NE (m k t j s : Nat) : QPres :=
  q4 (y3 ^ m) (SL1 j)
    (x3 * a3 ^ (((j - s : Nat)) : ℤ)) (a3 ^ k)

theorem nijinv02_step (m k t j s : Nat) (hs : s < j) :
    replay [.nijinv 0 2] (NE m k t j s) = some (NE m k t j (s + 1)) := by
  rw [replay_single, ap4_nijinv_02]
  have h2 : FreeGroup.lift s02 (x3 * a3 ^ (((j - s : Nat)) : ℤ))
      = x3 * a3 ^ (((j - (s + 1) : Nat)) : ℤ) := by
    rw [map_mul, lift_s02_x3, map_zpow,
      show FreeGroup.lift s02 a3 = a3 by simp only [a3, FreeGroup.lift_apply_of, s02_2]]
    have hA : (((j - (s + 1) : Nat)) : ℤ) = (((j - s : Nat)) : ℤ) - 1 := by
      have hjs : j - s = (j - (s + 1)) + 1 := by
        rw [Nat.sub_succ]
        exact (Nat.succ_pred_eq_of_pos (Nat.sub_pos_of_lt hs)).symm
      rw [hjs]; push_cast; ring
    rw [hA]
    group
  have h : (⟨3, 4, fun y => FreeGroup.lift s02
        (q4f (y3 ^ m) (SL1 j)
          (x3 * a3 ^ (((j - s : Nat)) : ℤ)) (a3 ^ k) y)⟩ : QPres)
      = NE m k t j (s + 1) := by
    rw [q4f_map]
    rw [q4f_congr (lift_s02_y_pow m) (lift_s02_slot1 j) h2 (lift_s02_a_pow k)]
  rw [h]

/-! #### The endgame: delete `x`, relabel, and fix `[x⁻ʲ,y]` -/

/-- `φ x = 1`, `φ y = of 0`, `φ a = of 1`: the relabelling `delete 0 2` performs. -/
def ph : Fin 3 → Word 2 := fun t => if h : t = 0 then 1 else FreeGroup.of (skipIndex 0 t h)

theorem ph_0 : ph 0 = 1 := by simp [ph]
theorem ph_1 : ph 1 = x2 := by simp [ph, skipIndex, x2]
theorem ph_2 : ph 2 = y2 := by simp [ph, skipIndex, y2]

theorem lift_ph_y_pow (m : Nat) : FreeGroup.lift ph (y3 ^ m) = x2 ^ m := by
  rw [map_pow, show FreeGroup.lift ph y3 = x2 by simp only [y3, FreeGroup.lift_apply_of, ph_1]]

theorem lift_ph_a_pow (k : Nat) : FreeGroup.lift ph (a3 ^ k) = y2 ^ k := by
  rw [map_pow, show FreeGroup.lift ph a3 = y2 by simp only [a3, FreeGroup.lift_apply_of, ph_2]]

theorem lift_ph_slot1 (j : Nat) : FreeGroup.lift ph (SL1 j) = SL2 j := by
  simp only [SL1, SL2, map_mul, map_inv, map_zpow, map_one, inv_one, one_mul, mul_one,
    x3, y3, a3, FreeGroup.lift_apply_of, ph_0, ph_1, ph_2]

theorem ne_last (m k t j : Nat) :
    NE m k t j j = q4 (y3 ^ m) (SL1 j) x3 (a3 ^ k) := by
  show q4 (y3 ^ m) (SL1 j)
      (x3 * a3 ^ (((j - j : Nat)) : ℤ)) (a3 ^ k) = _
  have h : x3 * a3 ^ (((j - j : Nat)) : ℤ) = x3 := by simp
  rw [h]

theorem nijinv02_iter (m k t j : Nat) : ∀ s, s ≤ j →
    replay (List.replicate s (.nijinv 0 2)) (NE m k t j 0) = some (NE m k t j s)
  | 0, _ => by simp [replay]
  | (s + 1), hs => by
    rw [show s + 1 = s + 1 from rfl, List.replicate_add (n := 1), List.replicate_one]
    exact replay_concat _ _ _ _ _ (nijinv02_iter m k t j s (Nat.le_of_succ_le hs))
      (by rw [replay_single]; exact nijinv02_step m k t j s (Nat.lt_of_succ_le hs))

/-- The relabelling `swap 0 1` performs. -/
def s01 : Fin 2 → Word 2 :=
  fun k => if k = 0 then FreeGroup.of 1 else if k = 1 then FreeGroup.of 0 else FreeGroup.of k

theorem s01_0 : s01 0 = y2 := by simp [s01, y2]
theorem s01_1 : s01 1 = x2 := by simp [s01, x2]

theorem ap2_swap_01 (r : Fin 3 → Word 2) :
    QMove.apply (.swap 0 1) (st2 r) = some (⟨2, 3, fun k => FreeGroup.lift s01 (r k)⟩ : QPres) := rfl

theorem lift_s01_x_pow (m : Nat) : FreeGroup.lift s01 (x2 ^ m) = y2 ^ m := by
  rw [map_pow, show FreeGroup.lift s01 x2 = y2 by simp only [x2, FreeGroup.lift_apply_of, s01_0]]

theorem lift_s01_y_pow (k : Nat) : FreeGroup.lift s01 (y2 ^ k) = x2 ^ k := by
  rw [map_pow, show FreeGroup.lift s01 y2 = x2 by simp only [y2, FreeGroup.lift_apply_of, s01_1]]

theorem lift_s01_slot1 (j : Nat) :
    FreeGroup.lift s01 (SL2 j) = x2 ^ (-(j : ℤ)) * y2 * x2 ^ (j : ℤ) * y2⁻¹ := by
  simp only [SL2, map_mul, map_inv, map_zpow, x2, y2, FreeGroup.lift_apply_of, s01_0, s01_1]

/-- The four endgame moves: delete the generator `x`, relabel, and turn `[x⁻ʲ,y]` into
`[xʲ,y]`. -/
def endMs (j : Nat) : List QMove :=
  [.delete 0 2 [], .swap 0 1, .conj 1 (lettersOf (x2 ^ j)), .inv 1]

theorem delete_apply (m j k : Nat) :
    QMove.apply (.delete 0 2 [])
        (q4 (y3 ^ m) (SL1 j) x3 (a3 ^ k))
      = some (q2 (x2 ^ m) (SL2 j) (y2 ^ k)) := by
  have hf : (fun y : Fin 3 => FreeGroup.lift ph
        (q4f (y3 ^ m) (SL1 j) x3 (a3 ^ k)
          (skipEmb (2 : Fin 4) y)))
      = q2f (x2 ^ m) (SL2 j) (y2 ^ k) := by
    funext y
    fin_cases y
    · show FreeGroup.lift ph (y3 ^ m) = x2 ^ m
      exact lift_ph_y_pow m
    · show FreeGroup.lift ph (SL1 j)
        = y2 ^ (-(j : ℤ)) * x2 * y2 ^ (j : ℤ) * x2⁻¹
      exact lift_ph_slot1 j
    · show FreeGroup.lift ph (a3 ^ k) = y2 ^ k
      exact lift_ph_a_pow k
  have hg : q4f (y3 ^ m) (SL1 j) x3 (a3 ^ k)
        (2 : Fin 4) = (1 : Word 3) * FreeGroup.of (0 : Fin 3) * (1 : Word 3)⁻¹ ∨
      q4f (y3 ^ m) (SL1 j) x3 (a3 ^ k)
        (2 : Fin 4) = (1 : Word 3) * (FreeGroup.of (0 : Fin 3))⁻¹ * (1 : Word 3)⁻¹ :=
    Or.inl (by simp [q4f_2, x3])
  simp only [QMove.apply]
  rw [dif_pos (show (0 : Nat) < 3 by decide), dif_pos (show (2 : Nat) < 4 by decide),
    show mkWordOpt 3 [] = some (1 : Word 3) from rfl]
  dsimp only
  split
  next h => exact congrArg (fun g : Fin (4 - 1) → Word (3 - 1) => (some (⟨3 - 1, 4 - 1, g⟩ : QPres))) hf
  next h => exact absurd hg h

/-- The slot-1 relator after phase 4 is `[a⁻ʲ,y]`, using that the scratch relator is `x aʲ`. -/
theorem slot1_clean (t j : Nat) :
    com3 * (d2v1 * (s2c t j j)⁻¹ * d2v1⁻¹) * (d2v2 * (s2c t j j) * d2v2⁻¹)
      = SL1 j := by
  simp only [com3, d2v1, d2v2, s2c, SL1, Nat.sub_self, Nat.mul_zero, Nat.cast_zero,
    zpow_zero, mul_one]
  group

/-- The slot-3 relator after phase 3 is `a^k`. -/
theorem s3d_last (t j k : Nat) (hk : k = 1 + t * j) : s3d t j t = a3 ^ k := by
  simp only [s3d, Nat.sub_self, Nat.cast_zero, zpow_zero, mul_one, Nat.cast_mul]
  rw [← zpow_natCast, hk, Nat.cast_add, Nat.cast_one, zpow_add, zpow_one]
  group

/-- The last three moves: relabel, conjugate `[x⁻ʲ,y]` by `xʲ`, and invert. -/
def endMs2 (j : Nat) : List QMove :=
  [.swap 0 1, .conj 1 (lettersOf (x2 ^ j)), .inv 1]

theorem endgame2 (m j k : Nat) :
    replay (endMs2 j)
        (q2 (x2 ^ m) (SL2 j) (y2 ^ k))
      = some (metz k m j) := by
  simp only [endMs2, replay, ap2_swap_01, q2f_map, upd_q2f_1, upd_q2f_2,
    q2f_0, q2f_1, q2f_2, ap2_conj_1, ap2_inv_1, lift_s01_x_pow, lift_s01_y_pow,
    lift_s01_slot1, Option.bind_some]
  rw [show ((x2 ^ j * (x2 ^ (-(j : ℤ)) * y2 * x2 ^ (j : ℤ) * y2⁻¹) * (x2 ^ j)⁻¹)⁻¹)
      = x2 ^ j * y2 * (x2 ^ j)⁻¹ * y2⁻¹ from by group]
  rfl

/-! ## The theorem -/

/-- The uniform move list of the recipe, `13 + 4t + 4j` moves. -/
def recipeMs (t j : Nat) : List QMove :=
  [.prolong] ++ (List.replicate t (.nijinv 2 0) ++ (stage2Ms t j j ++
    (phaseD3Ms t j t ++ (d2Ms ++ (List.replicate j (.nijinv 0 2) ++
      ([.delete 0 2 []] ++ endMs2 j))))))

/-- **The Metzler recipe for all parameters.**  For every `k, m, t, j` with `k = 1 + t * j`, the
presentation `<x,y | y^m, [x,y], x^k>` is `Q**`-equivalent to `<x,y | y^m, [x^j,y], x^k>`, by one
uniform move list of `13 + 4t + 4j` moves.  (`toolkit/lean/AC7.lean` proved the 14 instances and
the algebra; this is the statement for all parameters.) -/
theorem metzler_recipe (k m t j : Nat) (hk : k = 1 + t * j) :
    ∃ ms : List QMove, replay ms (metz k m 1) = some (metz k m j) := by
  have h0 : replay [.prolong] (metz k m 1) = some (q4 (y3 ^ m) com3 (x3 ^ k) a3) :=
    prolong_metz_clean k m
  have h1 : replay (List.replicate t (.nijinv 2 0)) (q4 (y3 ^ m) com3 (x3 ^ k) a3)
      = some (q4 (y3 ^ m) com3 (x3 ^ k) (s2d t)) := by
    have := nijinv_iter m k t 0
    rw [show q4 (y3 ^ m) com3 (x3 ^ k) a3
        = q4 (y3 ^ m) com3 (x3 ^ k) (a3 * x3 ^ (-(0 : ℤ))) from by
      rw [show a3 * x3 ^ (-(0 : ℤ)) = a3 from by simp]]
    simpa [Nat.zero_add, s2d] using this
  have h2 : replay (stage2Ms t j j) (q4 (y3 ^ m) com3 (x3 ^ k) (s2d t))
      = some (PA m k t j j) := by
    rw [stage2_base m k t j hk]
    exact stage2_iter m k t j j (Nat.le_refl j)
  have h3 : replay (phaseD3Ms t j t) (PA m k t j j) = some (PD m k t j t) := by
    rw [show PA m k t j j = PD m k t j 0 from phaseD3_base m k t j]
    exact phaseD3_iter m k t j t (Nat.le_refl t)
  have h4 : replay d2Ms (PD m k t j t) = some (q4 (y3 ^ m) (SL1 j) (s2c t j j) (a3 ^ k)) := by
    rw [show PD m k t j t = q4 (y3 ^ m) com3 (s2c t j j) (s3d t j t) from rfl,
      show s3d t j t = a3 ^ k from s3d_last t j k hk]
    rw [phaseD2, slot1_clean]
  have h5 : replay (List.replicate j (.nijinv 0 2)) (q4 (y3 ^ m) (SL1 j) (s2c t j j) (a3 ^ k))
      = some (q4 (y3 ^ m) (SL1 j) x3 (a3 ^ k)) := by
    have hne : q4 (y3 ^ m) (SL1 j) (s2c t j j) (a3 ^ k) = NE m k t j 0 := by
      rw [show NE m k t j 0
        = q4 (y3 ^ m) (SL1 j) (x3 * a3 ^ (((j - 0 : Nat)) : ℤ)) (a3 ^ k) from rfl]
      rw [show s2c t j j = x3 * a3 ^ (((j - 0 : Nat)) : ℤ) from by
        simp only [s2c, Nat.sub_zero, Nat.sub_self, Nat.mul_zero, Nat.cast_zero, zpow_zero,
          mul_one]]
    rw [hne, nijinv02_iter m k t j j (Nat.le_refl j), ne_last]
  have h6 : replay [.delete 0 2 []] (q4 (y3 ^ m) (SL1 j) x3 (a3 ^ k))
      = some (q2 (x2 ^ m) (SL2 j) (y2 ^ k)) := by
    rw [replay_single]
    exact delete_apply m j k
  have h7 := endgame2 m j k
  refine ⟨recipeMs t j, ?_⟩
  exact replay_concat [.prolong] _ _ _ _ h0
    (replay_concat (List.replicate t (.nijinv 2 0)) _ _ _ _ h1
      (replay_concat (stage2Ms t j j) _ _ _ _ h2
        (replay_concat (phaseD3Ms t j t) _ _ _ _ h3
          (replay_concat d2Ms _ _ _ _ h4
            (replay_concat (List.replicate j (.nijinv 0 2)) _ _ _ _ h5
              (replay_concat [.delete 0 2 []] _ _ _ _ h6 h7))))))

/-- The recipe for Metzler's own pair `(k,t,j) = (5,2,2)`, `m = 5`. -/
theorem metzler_recipe_pair : ∃ ms : List QMove, replay ms (metz 5 5 1) = some (metz 5 5 2) :=
  metzler_recipe 5 5 2 2 rfl

/-- The `(k,t,j) = (5,1,4)` row of round 6's family table. -/
theorem metzler_recipe_k5_j4 : ∃ ms : List QMove, replay ms (metz 5 5 1) = some (metz 5 5 4) :=
  metzler_recipe 5 5 1 4 rfl

/-- The `(k,t,j) = (13,4,3)` row. -/
theorem metzler_recipe_k13_j3 : ∃ ms : List QMove, replay ms (metz 13 7 1) = some (metz 13 7 3) :=
  metzler_recipe 13 7 4 3 rfl

theorem stage2Ms_length (t j s : Nat) : (stage2Ms t j s).length = 3 * s := by
  induction s with
  | zero => rfl
  | succ n ih => simp only [stage2Ms, List.length_append, ih, List.length_cons, List.length_nil]
                 ring

theorem phaseD3Ms_length (t j s : Nat) : (phaseD3Ms t j s).length = 3 * s := by
  induction s with
  | zero => rfl
  | succ n ih => simp only [phaseD3Ms, List.length_append, ih, List.length_cons, List.length_nil]
                 ring

/-- The move count is `13 + 4t + 4j`. -/
theorem recipeMs_length (t j : Nat) : (recipeMs t j).length = 13 + 4 * t + 4 * j := by
  simp only [recipeMs, stage2Ms_length, phaseD3Ms_length, d2Ms, endMs2, List.length_append,
    List.length_replicate, List.length_cons, List.length_nil]
  ring

/-- The move list has 29 moves at `t = j = 2` (round 6's certificate for the same pair has 44). -/
theorem recipeMs_two_two : (recipeMs 2 2).length = 29 := by rw [recipeMs_length]

set_option maxHeartbeats 1000000 in
/-- The two endpoints are different tuples: the theorem is not vacuous. -/
example : metz 5 5 1 ≠ metz 5 5 2 := by decide

set_option maxHeartbeats 1000000 in
/-- **Negative control on the move semantics.**  `delete 0 2` refuses the pair's start tuple,
because its third relator is `x^5`, not the generator `x`.  This is exactly the guard the endgame's
`delete` relies on, so the check that the endgame fires is not vacuous. -/
example : QMove.apply (.delete 0 2 []) (metz 5 5 1) = none := by decide

