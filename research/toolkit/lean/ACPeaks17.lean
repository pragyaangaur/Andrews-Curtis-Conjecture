/-! ## (d) Cocommutativity, and the exponent-sum kill

The winding invariant of Barmak is defined on relators in the commutator subgroup.  Theorem 1 of
`directions/invariant-ideas/idea.md` says that no balanced presentation of the trivial group is
AC-equivalent, at positive rank, to a tuple all of whose relators lie in the commutator subgroup,
and that the stable statement holds at rank at least one.  This section formalizes the engine and
the unstable statement, and states exactly which step of the stable statement is not formalized
here (see the ledger at the end of the file).

A word lies in the commutator subgroup of `F_n` exactly when all its exponent sums vanish, so the
predicate below is the formal version of "all relators are in the commutator subgroup". -/

/-- A presentation is *cocommutative* when every relator has zero exponent sum in every
generator, that is, when every relator lies in the commutator subgroup of the free group. -/
def Cocommutative {n : Nat} (P : Presentation n) : Prop :=
  ∀ (i a : Fin n), expSumAt a (P i) = 1

/-- Inversion of one relator preserves cocommutativity. -/
theorem cocommutative_invertAt {n : Nat} (P : Presentation n) (i : Fin n)
    (h : Cocommutative P) : Cocommutative (invertAt P i) := by
  intro j a
  rw [invertAt, setAt_apply]
  by_cases hj : j = i
  · rw [if_pos hj, map_inv, h i a, inv_one]
  · rw [if_neg hj]
    exact h j a

/-- Conjugation of one relator preserves cocommutativity. -/
theorem cocommutative_conjAt {n : Nat} (P : Presentation n) (i : Fin n) (w : Word n)
    (h : Cocommutative P) : Cocommutative (conjAt P i w) := by
  intro j a
  rw [conjAt, setAt_apply]
  by_cases hj : j = i
  · rw [if_pos hj]
    rw [map_mul, map_mul, map_inv, h i a, mul_one]
    exact mul_inv_cancel _
  · rw [if_neg hj]
    exact h j a

/-- Multiplication of one relator by another preserves cocommutativity. -/
theorem cocommutative_mulAt {n : Nat} (P : Presentation n) (i j : Fin n)
    (h : Cocommutative P) : Cocommutative (mulAt P i j) := by
  intro k a
  rw [mulAt, setAt_apply]
  by_cases hk : k = i
  · rw [if_pos hk, map_mul, h i a, h j a, mul_one]
  · rw [if_neg hk]
    exact h k a

/-- Every AC move carries a cocommutative tuple to a cocommutative tuple. -/
theorem Cocommutative.of_acMove {n : Nat} {P Q : Presentation n} (h : ACMove P Q) :
    Cocommutative P → Cocommutative Q := by
  induction h with
  | invert i P => exact cocommutative_invertAt P i
  | mul i j _ P => exact cocommutative_mulAt P i j
  | conj i w P => exact cocommutative_conjAt P i w

/-- Cocommutativity is invariant under AC-equivalence. -/
theorem Cocommutative.of_acEquiv {n : Nat} {P Q : Presentation n} (h : ACEquiv P Q) :
    Cocommutative P → Cocommutative Q := by
  induction h with
  | refl => exact id
  | tail _ hstep ih => exact fun hP => Cocommutative.of_acMove hstep (ih hP)

/-- The AC class of a tuple meets the cocommutative tuples exactly when the tuple is itself
cocommutative.  (Theorem 1 of `directions/invariant-ideas/idea.md`, first sentence of the
corollary, with no hypothesis on the presented group.) -/
theorem exists_cocommutative_acEquiv_iff {n : Nat} (P : Presentation n) :
    (∃ Q : Presentation n, ACEquiv P Q ∧ Cocommutative Q) ↔ Cocommutative P := by
  constructor
  · rintro ⟨Q, hQ, hco⟩
    exact Cocommutative.of_acEquiv (ACEquiv.symm hQ) hco
  · intro hP
    exact ⟨P, ACEquiv.refl P, hP⟩

/-- If a tuple is cocommutative and presents the trivial group then its rank is zero: the
`i`-th relator has exponent sum `±1` in the `i`-th generator by the arithmetic step of Lemma 8
(`expSum_eq_pm_one`), and cocommutativity makes that sum zero. -/
theorem not_cocommutative_of_subsingleton {n : Nat} (hn : 0 < n) (P : Presentation n)
    (htriv : Subsingleton (PresentedGroup (Set.range P))) : ¬ Cocommutative P := by
  intro hco
  have i0 : Fin n := ⟨0, hn⟩
  have hpm := expSum_eq_pm_one P i0 i0 (fun j _ => hco j i0) htriv
  have hzero : expSumAt i0 (P i0) = 1 := hco i0 i0
  rcases hpm with h | h
  · rw [hzero] at h
    have h2 : (0 : ℤ) = 1 := Multiplicative.ofAdd.injective (by rw [← h]; rfl)
    norm_num at h2
  · rw [hzero] at h
    have h2 : (0 : ℤ) = -1 := Multiplicative.ofAdd.injective (by rw [← h]; rfl)
    norm_num at h2

/-- **The cocommutativity kill theorem, unstable form.**  No tuple AC-equivalent to a balanced
presentation of the trivial group of positive rank is cocommutative. -/
theorem not_cocommutative_of_acEquiv {n : Nat} (hn : 0 < n) {P Q : Presentation n}
    (htriv : Subsingleton (PresentedGroup (Set.range P))) (h : ACEquiv P Q) :
    ¬ Cocommutative Q := by
  intro hQ
  exact not_cocommutative_of_subsingleton hn P htriv (Cocommutative.of_acEquiv (ACEquiv.symm h) hQ)

/-- Every relator of a positive-rank presentation of the trivial group has a nonzero exponent sum
in some generator: the explicit form of the kill. -/
theorem exists_expSum_ne_one {n : Nat} (hn : 0 < n) (P : Presentation n)
    (htriv : Subsingleton (PresentedGroup (Set.range P))) :
    ∃ (i a : Fin n), expSumAt a (P i) ≠ 1 := by
  by_contra hcon
  exact not_cocommutative_of_subsingleton hn P htriv (fun i a => by
    by_contra hne
    exact hcon ⟨i, a, hne⟩)


/-! ## (e) Lemma 8 with the generator relators in a permuted order

`AC2.lean` proves Lemma 8 of `survey/q-transformations.md` in the case where the relator at
position `j` is the generator `x_j` up to sign (all `j` other than a single position `i`), and
records in its ledger that the version with the generator relators in a *permuted* order is not
formalized there.  This section supplies it.  The new ingredient is that a relator tuple may be
permuted at the cost of Andrews-Curtis moves: the interchange lemma `acEquiv_swap` performs one
transposition, and `Equiv.Perm.swap_induction_on'` decomposes an arbitrary permutation into
transpositions. -/

/-- Relabel the relator positions of a presentation by a permutation of `Fin n`. -/
def permute {n : Nat} (P : Presentation n) (π : Equiv.Perm (Fin n)) : Presentation n :=
  fun k => P (π k)

/-- Permuting by the identity changes nothing. -/
theorem permute_one {n : Nat} (P : Presentation n) : permute P 1 = P := by
  funext k
  simp [permute]

/-- Permuting by `π` and then transposing the entries at `x` and `y` is permuting by
`π * swap x y`.  This is the form in which the interchange lemma is applied. -/
theorem permute_mul_swap {n : Nat} (P : Presentation n) (π : Equiv.Perm (Fin n))
    {x y : Fin n} (hxy : x ≠ y) :
    permute P (π * Equiv.swap x y) =
      setAt (setAt (permute P π) x (permute P π y)) y (permute P π x) := by
  funext k
  simp only [permute, Equiv.Perm.mul_apply, setAt_apply]
  rcases eq_or_ne k x with hx | hx
  · subst hx
    rw [Equiv.swap_apply_left, if_neg hxy, if_pos rfl]
  · rcases eq_or_ne k y with hy | hy
    · subst hy
      rw [Equiv.swap_apply_right, if_pos rfl]
    · rw [Equiv.swap_apply_of_ne_of_ne hx hy, if_neg hy, if_neg hx]

/-- Any permutation of the relator positions is realised by AC moves. -/
theorem acEquiv_permute {n : Nat} (P : Presentation n) (π : Equiv.Perm (Fin n)) :
    ACEquiv P (permute P π) := by
  classical
  refine Equiv.Perm.swap_induction_on' (motive := fun π => ACEquiv P (permute P π)) π ?_ ?_
  · rw [permute_one]
    exact ACEquiv.refl P
  · intro σ x y hxy ih
    rw [permute_mul_swap P σ hxy]
    exact ih.trans (acEquiv_swap (permute P σ) hxy)

/-- **Lemma 8 of `survey/q-transformations.md`, permuted form.**  Let `P` be a balanced
presentation of rank `n` of the trivial group, let `π` be a permutation of `Fin n`, and suppose
that for every `j ≠ i` the relator at position `π j` is the generator `x_j` up to sign.  (So the
generator relators occur in the permuted order `π`; the relator at position `π i` is arbitrary.)
Then `P` is AC-equivalent to the standard tuple. -/
theorem acEquiv_standard_of_generator_relators_perm {n : Nat} (P : Presentation n) (i : Fin n)
    (π : Equiv.Perm (Fin n))
    (hgen : ∀ j, j ≠ i → P (π j) = FreeGroup.of j ∨ P (π j) = (FreeGroup.of j)⁻¹)
    (htriv : Subsingleton (PresentedGroup (Set.range P))) :
    ACEquiv P (standard n) := by
  have hp : ACEquiv P (permute P π) := acEquiv_permute P π
  have htriv' : Subsingleton (PresentedGroup (Set.range (permute P π))) :=
    (presentedGroup_subsingleton_iff hp).mp htriv
  refine hp.trans (acEquiv_standard_of_generator_relators (permute P π) i ?_ htriv')
  intro j hj
  exact hgen j hj

/-- The permuted Lemma 8 contains the unpermuted one: the identity permutation gives Lemma 8 of
`AC2.lean`. -/
theorem acEquiv_standard_of_generator_relators_via_perm {n : Nat} (P : Presentation n)
    (i : Fin n)
    (hgen : ∀ j, j ≠ i → P j = FreeGroup.of j ∨ P j = (FreeGroup.of j)⁻¹)
    (htriv : Subsingleton (PresentedGroup (Set.range P))) :
    ACEquiv P (standard n) :=
  acEquiv_standard_of_generator_relators_perm P i 1 (by simpa using hgen) htriv

/-- The hypotheses of the permuted Lemma 8 are satisfiable: the standard rank-two tuple with its
two relators exchanged satisfies them with the wild relator at position `0`. -/
example :
    ACEquiv (permute (standard 2) (Equiv.swap 0 1)) (standard 2) := by
  have hp : ACEquiv (standard 2) (permute (standard 2) (Equiv.swap 0 1)) :=
    acEquiv_permute (standard 2) (Equiv.swap 0 1)
  have htriv : Subsingleton (PresentedGroup (Set.range (standard 2))) :=
    subsingleton_presentedGroup_standard 2
  exact acEquiv_standard_of_generator_relators_perm _ 0 (Equiv.swap 0 1)
    (by
      intro j hj
      have h1 : permute (standard 2) (Equiv.swap 0 1) (Equiv.swap 0 1 j) = standard 2 j := by
        simp [permute]
      rw [h1]
      exact Or.inl rfl)
    ((presentedGroup_subsingleton_iff hp).mp htriv)


/-! ## (f) A verifier for explicit AC certificates

Rounds 1 and 2 produced explicit move lists (certificates) for many pairs of presentations, in
the JSON format of `directions/ms-ak-certs/` and the text format of `directions/c14/`.  The
verifier below replays such a list inside Lean.  A certificate is checked by `decide`, which
computes in the kernel: no `native_decide` is used, and the resulting theorem carries no
assumption beyond Lean's standard axioms.  `toolkit/lean/cert_to_lean.py` converts the two file
formats into the `Move` lists used here. -/

/-- One recorded Andrews-Curtis move.  Indices are zero-based, as in `directions/c14/`; the file
converters subtract one from the one-based indices of `directions/ms-ak-certs/`. -/
inductive Move (n : Nat) : Type where
  /-- Invert the `i`-th relator. -/
  | invert (i : Fin n)
  /-- Conjugate the `i`-th relator by the word `w`. -/
  | conj (i : Fin n) (w : Word n)
  /-- Multiply the `i`-th relator by the `j`-th relator. -/
  | mul (i j : Fin n)

/-- Apply one recorded move.  The multiplication move is undefined for `i = j`, since no
certificate may use it; a certificate that does is rejected. -/
def Move.apply {n : Nat} (m : Move n) (P : Presentation n) : Option (Presentation n) :=
  match m with
  | Move.invert i => some (invertAt P i)
  | Move.conj i w => some (conjAt P i w)
  | Move.mul i j => if i = j then none else some (mulAt P i j)

/-- Each recorded move really is a sequence of Andrews-Curtis moves. -/
theorem Move.apply_sound {n : Nat} (m : Move n) (P Q : Presentation n)
    (h : m.apply P = some Q) : ACEquiv P Q := by
  cases m with
  | invert i =>
      have h' : invertAt P i = Q := by simpa [Move.apply] using h
      subst h'
      exact ACEquiv.of_move (ACMove.invert i P)
  | conj i w =>
      have h' : conjAt P i w = Q := by simpa [Move.apply] using h
      subst h'
      exact ACEquiv.of_move (ACMove.conj i w P)
  | mul i j =>
      by_cases hij : i = j
      · simp [Move.apply, hij] at h
      · have h' : mulAt P i j = Q := by
          simpa [Move.apply, hij] using h
        subst h'
        exact ACEquiv.of_move (ACMove.mul i j hij P)

/-- Replay a list of recorded moves. -/
def replay {n : Nat} : List (Move n) → Presentation n → Option (Presentation n)
  | [], P => some P
  | m :: ms, P => (m.apply P).bind (replay ms)

/-- Replaying a certificate yields an Andrews-Curtis equivalence. -/
theorem replay_sound {n : Nat} : ∀ (ms : List (Move n)) (P Q : Presentation n),
    replay ms P = some Q → ACEquiv P Q
  | [], P, Q, h => by
      have h' : P = Q := by simpa [replay] using h
      rw [h']
      exact ACEquiv.refl Q
  | m :: ms, P, Q, h => by
      cases hstep : m.apply P with
      | none => simp [replay, hstep] at h
      | some P' =>
          have hrest : replay ms P' = some Q := by simpa [replay, hstep] using h
          exact (Move.apply_sound m P P' hstep).trans (replay_sound ms P' Q hrest)

/-- The certificate checker.  It recomputes the chain from the recorded start tuple and compares
the result with the recorded finish tuple. -/
def checkCert {n : Nat} (ms : List (Move n)) (start finish : Presentation n) : Bool :=
  decide (replay ms start = some finish)

/-- Replaying a concatenation: the first block reaches an intermediate tuple and the second block
carries on from it. -/
theorem replay_append {n : Nat} : ∀ (ms₁ ms₂ : List (Move n)) (P R : Presentation n),
    replay ms₁ P = some R → replay (ms₁ ++ ms₂) P = replay ms₂ R
  | [], ms₂, P, R, h => by
      have h' : P = R := by simpa [replay] using h
      rw [h']
      rfl
  | m :: ms₁, ms₂, P, R, h => by
      cases hstep : m.apply P with
      | none => simp [replay, hstep] at h
      | some P' =>
          have hrest : replay ms₁ P' = some R := by simpa [replay, hstep] using h
          rw [List.cons_append, replay, hstep]
          exact replay_append ms₁ ms₂ P' R hrest

/-- **Certificates compose.**  A block of moves checked from `start` to `mid`, followed by a block
checked from `mid` to `finish`, gives a certificate for the concatenation.  This is what lets a
long chain be checked in blocks, each of them a separate kernel computation. -/
theorem checkCert_append {n : Nat} {ms₁ ms₂ : List (Move n)} {start mid finish : Presentation n}
    (h₁ : checkCert ms₁ start mid = true) (h₂ : checkCert ms₂ mid finish = true) :
    checkCert (ms₁ ++ ms₂) start finish = true := by
  have h₁' : replay ms₁ start = some mid := of_decide_eq_true h₁
  have h₂' : replay ms₂ mid = some finish := of_decide_eq_true h₂
  have h3 : replay (ms₁ ++ ms₂) start = replay ms₂ mid := replay_append ms₁ ms₂ start mid h₁'
  have h4 : replay (ms₁ ++ ms₂) start = some finish := by rw [h3, h₂']
  rw [checkCert, h4]
  simp

/-- **The checker is sound**: a certificate that passes yields an AC-equivalence between its
recorded first and last tuples. -/
theorem checkCert_sound {n : Nat} {ms : List (Move n)} {start finish : Presentation n}
    (h : checkCert ms start finish = true) : ACEquiv start finish :=
  replay_sound ms start finish (of_decide_eq_true h)

/-- A word from a list of signed generators; `true` is the generator, `false` its inverse. -/
def mkWord {n : Nat} (l : List (Fin n × Bool)) : Word n := FreeGroup.mk l

/-- A presentation from a list of words, one per generator; missing entries are empty. -/
def mkPres {n : Nat} (l : List (List (Fin n × Bool))) : Presentation n :=
  fun i => mkWord (l.getD i.val [])


/-- Certificate from `directions/ms-ak-certs/cert_n2.json`: AK(2) is AC-equivalent to
MS(2, w_1) in 11 moves. -/
def certAK2start : Presentation 2 :=
  mkPres (n := 2) [[(0,true),(0,true),(1,false),(1,false),(1,false)],
   [(0,true),(1,true),(0,true),(1,false),(0,false),(1,false)]]
def certAK2moves : List (Move 2) :=
  [ Move.conj 0 (mkWord (n := 2) [(1,true)]),
    Move.invert 1,
    Move.conj 1 (mkWord (n := 2) [(1,true),(0,true),(1,false),(0,false)]),
    Move.conj 0 (mkWord (n := 2) [(1,true),(0,true),(1,false),(0,false),(1,true),(0,true),(1,true),(0,false),(0,false),(1,false)]),
    Move.mul 0 1,
    Move.conj 1 (mkWord (n := 2) [(0,true),(1,true),(0,false),(1,false)]),
    Move.conj 1 (mkWord (n := 2) [(0,false)]),
    Move.conj 0 (mkWord (n := 2) [(0,false),(1,true),(0,true),(1,true),(0,false),(1,false)]),
    Move.mul 0 1,
    Move.conj 1 (mkWord (n := 2) [(0,true)]),
    Move.conj 1 (mkWord (n := 2) [(1,false),(0,false),(1,false)]) ]
def certAK2finish : Presentation 2 :=
  mkPres (n := 2) [[(0,false),(1,true),(1,true),(0,true),(1,false),(1,false),(1,false)],
   [(0,false),(1,false),(0,false),(1,true),(0,true),(1,true)]]
theorem certAK2_check :
    checkCert certAK2moves certAK2start certAK2finish = true := by decide
theorem certAK2_sound : ACEquiv certAK2start certAK2finish :=
  checkCert_sound certAK2_check


/-! ## (g) Stabilization and the stable form of the kill

The stable Andrews-Curtis conjecture allows a rank-changing move: add a new generator together
with the relator that equals it ("stabilization"), or delete such a pair.  This section
formalizes that move on presentations of arbitrary rank and proves that the triviality of the
presented group is preserved by it in both directions.  Combined with the kill theorem of
section (d) this gives the stable form of the kill at every rank `m ≥ 1`. -/

/-- The image of a rank-`n` word in the free group of rank `n+1` obtained by adding one generator
at the end. -/
def liftWord {n : Nat} (w : Word n) : Word (n+1) := FreeGroup.map Fin.castSucc w

theorem liftWord_of {n : Nat} (a : Fin n) :
    liftWord (FreeGroup.of a) = FreeGroup.of (Fin.castSucc a) :=
  FreeGroup.map.of

theorem liftWord_one {n : Nat} : liftWord (1 : Word n) = 1 := map_one _

theorem liftWord_mul {n : Nat} (u v : Word n) : liftWord (u * v) = liftWord u * liftWord v :=
  map_mul _ _ _

theorem liftWord_inv {n : Nat} (u : Word n) : liftWord u⁻¹ = (liftWord u)⁻¹ := map_inv _ _

/-- Stabilization of a presentation by a word: add one generator, the last one, together with the
relator `x_n * w`, which determines the new generator to be `w⁻¹` in the presented group.  The
case `w = 1` is the balance-preserving stabilization of the Shehper move set, where the new
relator equals the new generator. -/
def stabWith {n : Nat} (P : Presentation n) (w : Word n) : Presentation (n+1) :=
  Fin.snoc (fun i => liftWord (P i)) (FreeGroup.of (Fin.last n) * liftWord w)

/-- The balance-preserving stabilization: add one generator together with the relator equal to
it. -/
def stab {n : Nat} (P : Presentation n) : Presentation (n+1) := stabWith P 1

theorem stabWith_castSucc {n : Nat} (P : Presentation n) (w : Word n) (i : Fin n) :
    stabWith P w (Fin.castSucc i) = liftWord (P i) :=
  Fin.snoc_castSucc _ _ _

theorem stabWith_last {n : Nat} (P : Presentation n) (w : Word n) :
    stabWith P w (Fin.last n) = FreeGroup.of (Fin.last n) * liftWord w :=
  Fin.snoc_last _ _

theorem stab_castSucc {n : Nat} (P : Presentation n) (i : Fin n) :
    stab P (Fin.castSucc i) = liftWord (P i) :=
  stabWith_castSucc P 1 i

theorem stab_last {n : Nat} (P : Presentation n) :
    stab P (Fin.last n) = FreeGroup.of (Fin.last n) := by
  rw [stab, stabWith_last, liftWord_one, mul_one]

/-- **Triviality is preserved by stabilization, forward direction.**  If a presentation presents
the trivial group, so does its stabilization: any homomorphism out of the stabilized free group
that kills the relators kills the new generator by the new relator, restricts to a homomorphism
that kills the old relators, and that one is trivial by hypothesis. -/
theorem subsingleton_presentedGroup_of_stabWith {n : Nat} (P : Presentation n) (w : Word n)
    (h : Subsingleton (PresentedGroup (Set.range P))) :
    Subsingleton (PresentedGroup (Set.range (stabWith P w))) := by
  classical
  -- the canonical map out of the stabilized free group
  set F : Word (n+1) →* PresentedGroup (Set.range (stabWith P w)) :=
    PresentedGroup.mk (Set.range (stabWith P w)) with hF
  -- it kills the new relator `x_n * w`
  have hrelnew : F (FreeGroup.of (Fin.last n) * liftWord w) = 1 :=
    PresentedGroup.one_of_mem ⟨Fin.last n, stabWith_last P w⟩
  -- its composite with the inclusion of the old generators kills the old relators
  have hcomp : F.comp (FreeGroup.map Fin.castSucc) = 1 := by
    -- identify the composite with the lift of `a ↦ F (of (castSucc a))`
    set f : Fin n → PresentedGroup (Set.range (stabWith P w)) :=
      fun a => F (FreeGroup.of (Fin.castSucc a)) with hf
    have hlift : FreeGroup.lift f = F.comp (FreeGroup.map Fin.castSucc) := by
      refine FreeGroup.ext_hom _ _ fun a => ?_
      simp [hf, FreeGroup.map.of]
    have hrel : ∀ r ∈ Set.range P, FreeGroup.lift f r = 1 := by
      rintro r ⟨j, rfl⟩
      rw [hlift, MonoidHom.comp_apply]
      show F (liftWord (P j)) = 1
      rw [← stabWith_castSucc P w j]
      exact PresentedGroup.one_of_mem ⟨Fin.castSucc j, rfl⟩
    -- triviality of the old presented group makes the extension of `f` trivial
    have hone : PresentedGroup.toGroup hrel = 1 := by
      refine MonoidHom.ext fun x => ?_
      have : Subsingleton (PresentedGroup (Set.range P)) := h
      rw [show x = 1 from Subsingleton.elim x 1, map_one, MonoidHom.one_apply]
    rw [← hlift]
    refine FreeGroup.ext_hom _ _ fun a => ?_
    have h2 : FreeGroup.lift f (FreeGroup.of a)
        = PresentedGroup.toGroup hrel (PresentedGroup.mk (Set.range P) (FreeGroup.of a)) := rfl
    rw [h2, hone]
    simp
  -- the old generators are killed
  have hw : F (liftWord w) = 1 := by
    rw [liftWord, ← MonoidHom.comp_apply, hcomp, MonoidHom.one_apply]
  -- hence the new generator is killed as well, and with it every generator
  have hlast : F (FreeGroup.of (Fin.last n)) = 1 := by
    have h2 : F (FreeGroup.of (Fin.last n)) * F (liftWord w) = 1 := by
      rw [← map_mul]
      exact hrelnew
    rwa [hw, mul_one] at h2
  have hone : ∀ j : Fin (n+1), F (FreeGroup.of j) = 1 := by
    intro j
    cases j using Fin.lastCases with
    | last => exact hlast
    | cast a =>
        have h2 : F (FreeGroup.of (Fin.castSucc a))
            = (F.comp (FreeGroup.map Fin.castSucc)) (FreeGroup.of a) := by
          simp [FreeGroup.map.of]
        rw [h2, hcomp, MonoidHom.one_apply]
  -- so `F` is trivial, and `F` is surjective
  have hF1 : F = 1 := by
    refine FreeGroup.ext_hom _ _ fun j => ?_
    rw [MonoidHom.one_apply]
    exact hone j
  refine ⟨fun x y => ?_⟩
  obtain ⟨a, rfl⟩ := PresentedGroup.mk_surjective (Set.range (stabWith P w)) x
  obtain ⟨b, rfl⟩ := PresentedGroup.mk_surjective (Set.range (stabWith P w)) y
  rw [← hF, hF1]
  rfl


/-- Lifting a word and then applying `FreeGroup.lift g` is applying the lift of the composite
map on generators. -/
theorem liftWord_lift {n : Nat} {H : Type} [Group H] (g : Fin (n+1) → H) (w : Word n) :
    FreeGroup.lift g (liftWord w) = FreeGroup.lift (fun a => g (Fin.castSucc a)) w := by
  have h : (FreeGroup.lift g).comp (FreeGroup.map Fin.castSucc)
      = FreeGroup.lift (fun a => g (Fin.castSucc a)) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    simp [FreeGroup.map.of]
  rw [liftWord, ← MonoidHom.comp_apply, h]

/-- **Triviality is preserved by stabilization by a word, backward direction.**  If the
stabilization presents the trivial group, so does the presentation: mapping the new generator to
`(w)⁻¹` in the old presented group gives a homomorphism from the stabilized free group to the old
presented group which kills the relators of the stabilization, and triviality of the stabilized
group makes it trivial. -/
theorem subsingleton_of_subsingleton_stabWith {n : Nat} (P : Presentation n) (w : Word n)
    (h : Subsingleton (PresentedGroup (Set.range (stabWith P w)))) :
    Subsingleton (PresentedGroup (Set.range P)) := by
  classical
  -- the map on generators: old generator to itself, new generator to `w⁻¹`
  set g : Fin (n+1) → PresentedGroup (Set.range P) :=
    Fin.lastCases ((PresentedGroup.mk (Set.range P) w)⁻¹) (fun a => PresentedGroup.of a) with hg
  have hg_cast : ∀ a : Fin n, g (Fin.castSucc a) = PresentedGroup.of a := by
    intro a
    simp [hg]
  have hg_last : g (Fin.last n) = (PresentedGroup.mk (Set.range P) w)⁻¹ := by
    simp [hg]
  -- the lift of the inclusion of the old generators is the canonical map
  have hmk : FreeGroup.lift (fun a => PresentedGroup.of (rels := Set.range P) a)
      = PresentedGroup.mk (Set.range P) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    rfl
  have hfun : (fun b => g (Fin.castSucc b)) = fun b => PresentedGroup.of (rels := Set.range P) b :=
    funext hg_cast
  -- it kills the relators of the stabilization
  have hrel : ∀ r ∈ Set.range (stabWith P w), FreeGroup.lift g r = 1 := by
    rintro r ⟨k, rfl⟩
    cases k using Fin.lastCases with
    | last =>
        rw [stabWith_last, map_mul, FreeGroup.lift_apply_of, hg_last,
          liftWord_lift, hfun, hmk]
        exact inv_mul_cancel _
    | cast a =>
        rw [stabWith_castSucc]
        rw [liftWord_lift, hfun, hmk]
        exact PresentedGroup.one_of_mem ⟨a, rfl⟩
  -- the stabilized group is trivial, so every element of its normal closure is killed
  have htop : Subgroup.normalClosure (Set.range (stabWith P w)) = ⊤ := by
    refine le_antisymm le_top fun x _ => ?_
    exact PresentedGroup.mk_eq_one_iff.mp (Subsingleton.elim _ _)
  -- hence every generator of the old free group maps to `1`
  have hgen : ∀ a : Fin n, PresentedGroup.of (rels := Set.range P) a = 1 := by
    intro a
    have hmem : FreeGroup.of (Fin.castSucc a) ∈ Subgroup.normalClosure (Set.range (stabWith P w)) := by
      rw [htop]
      exact Subgroup.mem_top _
    have h2 := PresentedGroup.to_group_eq_one_of_mem_closure (f := g) hrel _ hmem
    rw [FreeGroup.lift_apply_of, hg_cast a] at h2
    exact h2
  -- so the old presented group is trivial
  have hall : ∀ x : PresentedGroup (Set.range P), x = 1 := by
    intro x
    have h1 := PresentedGroup.generated_by (Set.range P) (⊥ : Subgroup (PresentedGroup (Set.range P)))
      (by
        intro j
        rw [hgen j]
        exact Subgroup.one_mem _) x
    simpa using h1
  exact ⟨fun x y => by rw [hall x, hall y]⟩

/-- Triviality is preserved by the balance-preserving stabilization, backward direction. -/
theorem subsingleton_of_subsingleton_stab {n : Nat} (P : Presentation n)
    (h : Subsingleton (PresentedGroup (Set.range (stab P)))) :
    Subsingleton (PresentedGroup (Set.range P)) :=
  subsingleton_of_subsingleton_stabWith P 1 h

/-- Triviality is preserved by the balance-preserving stabilization, forward direction. -/
theorem subsingleton_presentedGroup_of_stab {n : Nat} (P : Presentation n)
    (h : Subsingleton (PresentedGroup (Set.range P))) :
    Subsingleton (PresentedGroup (Set.range (stab P))) :=
  subsingleton_presentedGroup_of_stabWith P 1 h

/-- A single move of the stable Andrews-Curtis relation, on presentations of arbitrary rank: an
AC move at fixed rank, a stabilization by a word, or a destabilization (the inverse of a
stabilization).  The case `w = 1` is the balance-preserving stabilization of the Shehper move
set. -/
inductive StableMove : (Σ n : Nat, Presentation n) → (Σ n : Nat, Presentation n) → Prop where
  | ac {n : Nat} {P Q : Presentation n} (h : ACMove P Q) : StableMove ⟨n, P⟩ ⟨n, Q⟩
  | stab {n : Nat} (P : Presentation n) (w : Word n) :
      StableMove ⟨n, P⟩ ⟨n+1, stabWith P w⟩
  | destab {n : Nat} (P : Presentation n) (w : Word n) :
      StableMove ⟨n+1, stabWith P w⟩ ⟨n, P⟩

/-- Stable Andrews-Curtis equivalence: the reflexive transitive closure of `StableMove`. -/
def StablyACEquiv (A B : Σ n : Nat, Presentation n) : Prop :=
  Relation.ReflTransGen StableMove A B

/-- Every stable move preserves triviality of the presented group, in both directions. -/
theorem subsingleton_iff_of_stableMove {A B : Σ n : Nat, Presentation n} (h : StableMove A B) :
    Subsingleton (PresentedGroup (Set.range A.2)) ↔
      Subsingleton (PresentedGroup (Set.range B.2)) := by
  induction h with
  | ac hmove => exact presentedGroup_subsingleton_iff (ACEquiv.of_move hmove)
  | stab P w =>
      exact ⟨subsingleton_presentedGroup_of_stabWith P w,
        subsingleton_of_subsingleton_stabWith P w⟩
  | destab P w =>
      exact ⟨subsingleton_of_subsingleton_stabWith P w,
        subsingleton_presentedGroup_of_stabWith P w⟩

/-- Triviality of the presented group is preserved along a stable AC-equivalence. -/
theorem subsingleton_of_stablyACEquiv {A B : Σ n : Nat, Presentation n}
    (h : StablyACEquiv A B) :
    Subsingleton (PresentedGroup (Set.range A.2)) →
      Subsingleton (PresentedGroup (Set.range B.2)) := by
  induction h with
  | refl => exact id
  | tail _ hstep ih => exact fun hA => (subsingleton_iff_of_stableMove hstep).mp (ih hA)

/-- **The cocommutativity kill theorem, stable form.**  Let `P` be a presentation of the trivial
group of any rank and let `Q` be a presentation of rank `m ≥ 1` that is stably AC-equivalent to
`P`.  Then `Q` is not cocommutative: some relator of `Q` has a nonzero exponent sum. -/
theorem not_cocommutative_of_stablyACEquiv {n m : Nat} {P : Presentation n}
    {Q : Presentation m} (hm : 0 < m)
    (htriv : Subsingleton (PresentedGroup (Set.range P)))
    (h : StablyACEquiv ⟨n, P⟩ ⟨m, Q⟩) : ¬ Cocommutative Q :=
  not_cocommutative_of_subsingleton hm Q (subsingleton_of_stablyACEquiv h htriv)

/-- The stabilization of the standard tuple is the standard tuple of the next rank. -/
theorem stab_standard {n : Nat} : stab (standard n) = standard (n+1) := by
  funext k
  cases k using Fin.lastCases with
  | last => rw [stab_last]; rfl
  | cast a => rw [stab_castSucc]; rfl

/-- A concrete instance of the kill, and a check that its hypotheses are satisfiable: the
standard tuple of every positive rank is not cocommutative. -/
example (m : Nat) : ¬ Cocommutative (standard (m+1)) :=
  not_cocommutative_of_subsingleton (Nat.succ_pos m) _
    (subsingleton_presentedGroup_standard (m+1))
