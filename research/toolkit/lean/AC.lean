import Mathlib

/-!
# Andrews-Curtis moves: a Lean 4 toolkit

This file gives a machine-checked formulation of the Andrews-Curtis (AC) moves on
balanced presentations, the AC-equivalence relation, and one classical invariant of
the moves.

## Conventions

* A *word* of rank `n` is an element of the free group `FreeGroup (Fin n)`, written
  `Word n`.
* A *rank-`n` presentation* is a relator tuple `P : Fin n → Word n`, that is, `n`
  relators in `n` letters.  `Presentation.toList` converts it to a list, and
  `Presentation.length_toList` proves that the list has exactly `n` entries, so the
  balancing condition is part of the definition.
* No quotient of the free group by the normal closure of the relators is taken in this
  file.  A presentation here is the relator tuple, which is exactly what the AC moves
  act on.  Nothing about the triviality of a presented group is formalized.

## The moves

The three moves of Andrews and Curtis are, on the tuple of relators,

1. `r i -> (r i)^-1`            (`invertAt`),
2. `r i -> r i * r j`, `i != j`  (`mulAt`),
3. `r i -> w * r i * w^-1`      (`conjAt`).

`ACMove` is the inductive relation generated by them, and `ACEquiv` is its reflexive
transitive closure.

## Main results

* `ACEquiv.refl`, `ACEquiv.trans`, `ACEquiv.symm`: AC-equivalence is an equivalence
  relation.  Symmetry is the substantive part, because the reverse of move 2 has to be
  built out of the three moves; `ACMove.toEquiv` realizes it with three of them.
* `ACEquiv.mulInv` and `ACEquiv.mulLeft`: the derived moves `r i -> r i * (r j)^-1` and
  `r i -> r j * r i`, each three moves long.  The first of them is exactly the move that
  undoes move 2.  Left multiplication by another relator is
  therefore available, although only right multiplication is a primitive move.
* `expSumVec` is the exponent-sum vector of a word, and `abSpan P` is the `Z`-span in
  `Z^n` of the exponent-sum vectors of the relators of `P`.  `abSpan_eq_of_acMove` and
  `abSpan_eq_of_acEquiv` prove that every AC move preserves this span.
* `abSpan_AK3_eq_abSpan_standard`: the standard rank-two presentation and AK(3) have
  the same exponent-sum span, namely everything.  The two exponent-sum vectors of AK(3)
  are computed in `expSumVec_AK3_zero` and `expSumVec_AK3_one`, and the matrix they form
  has determinant `-1`, a unit of `Z`.  This is a machine-checked instance of the fact
  that the abelian invariant cannot separate a balanced presentation of the trivial
  group from the standard one.
* `not_acEquiv_standard_rankOneSq`: the invariant does detect something.  The rank-one
  presentations `x` and `x^2` are not AC-equivalent.  Both are outside the conjecture
  (the second presents the cyclic group of order two), but the proof exercises the
  invariant end to end.

## Scope

The general statement that two balanced presentations of the trivial group have the
same abelian span is not formalized here, because it needs the link between a
presentation and its abelianization.  What is formalized is the invariance of the span
and the two worked instances above.  Nothing in this file bears on the truth of the
Andrews-Curtis conjecture, and no claim in either direction is made.
-/

namespace AndrewsCurtis

/-! ## Words, presentations, and replacement of one relator -/

/-- A word in the free group on `n` generators. -/
abbrev Word (n : Nat) : Type := FreeGroup (Fin n)

/-- A rank-`n` presentation: `n` relators in the free group on `n` letters. -/
abbrev Presentation (n : Nat) : Type := Fin n → Word n

/-- The relator tuple as an honest list. -/
def Presentation.toList {n : Nat} (P : Presentation n) : List (Word n) := List.ofFn P

/-- A rank-`n` presentation has exactly `n` relators. -/
theorem Presentation.length_toList {n : Nat} (P : Presentation n) : P.toList.length = n :=
  List.length_ofFn

/-- Replace the `i`-th relator by `v`. -/
def setAt {n : Nat} (P : Presentation n) (i : Fin n) (v : Word n) : Presentation n :=
  fun k => if k = i then v else P k

theorem setAt_apply {n : Nat} (P : Presentation n) (i k : Fin n) (v : Word n) :
    setAt P i v k = if k = i then v else P k := rfl

theorem setAt_self {n : Nat} (P : Presentation n) (i : Fin n) (v : Word n) :
    setAt P i v i = v := by simp [setAt]

theorem setAt_of_ne {n : Nat} (P : Presentation n) {i : Fin n} (v : Word n) {k : Fin n}
    (h : k ≠ i) : setAt P i v k = P k := by simp [setAt, h]

/-- Invert the `i`-th relator: AC move (1). -/
def invertAt {n : Nat} (P : Presentation n) (i : Fin n) : Presentation n :=
  setAt P i (P i)⁻¹

/-- Conjugate the `i`-th relator by `w`: AC move (3). -/
def conjAt {n : Nat} (P : Presentation n) (i : Fin n) (w : Word n) : Presentation n :=
  setAt P i (w * P i * w⁻¹)

/-- Multiply the `i`-th relator on the right by the `j`-th relator: AC move (2). -/
def mulAt {n : Nat} (P : Presentation n) (i j : Fin n) : Presentation n :=
  setAt P i (P i * P j)

/-- Multiply the `i`-th relator on the right by the inverse of the `j`-th relator.
This is not one of the three moves; it is a derived move, three moves long. -/
def mulInvAt {n : Nat} (P : Presentation n) (i j : Fin n) : Presentation n :=
  setAt P i (P i * (P j)⁻¹)

/-! ## The moves and AC-equivalence -/

variable {n : Nat}

/-- The three Andrews-Curtis moves on relator tuples of rank `n`. -/
inductive ACMove : Presentation n → Presentation n → Prop where
  | invert (i : Fin n) (P : Presentation n) : ACMove P (invertAt P i)
  | mul (i j : Fin n) (h : i ≠ j) (P : Presentation n) : ACMove P (mulAt P i j)
  | conj (i : Fin n) (w : Word n) (P : Presentation n) : ACMove P (conjAt P i w)

/-- Andrews-Curtis equivalence: the reflexive transitive closure of `ACMove`. -/
def ACEquiv (P Q : Presentation n) : Prop := Relation.ReflTransGen ACMove P Q

theorem ACEquiv.refl (P : Presentation n) : ACEquiv P P := Relation.ReflTransGen.refl

theorem ACEquiv.trans {P Q R : Presentation n} (h₁ : ACEquiv P Q) (h₂ : ACEquiv Q R) :
    ACEquiv P R := Relation.ReflTransGen.trans h₁ h₂

theorem ACEquiv.of_move {P Q : Presentation n} (h : ACMove P Q) : ACEquiv P Q :=
  Relation.ReflTransGen.single h

/-! ## Each move is undone by a short sequence of moves -/

/-- Inverting twice restores the tuple. -/
theorem invertAt_involutive {n : Nat} (P : Presentation n) (i : Fin n) :
    invertAt (invertAt P i) i = P := by
  funext k
  by_cases hk : k = i
  · rw [hk]
    simp [invertAt, setAt]
  · simp [invertAt, setAt, hk]

/-- Conjugating by `w` and then by `w⁻¹` restores the tuple. -/
theorem conjAt_undo {n : Nat} (P : Presentation n) (i : Fin n) (w : Word n) :
    conjAt (conjAt P i w) i w⁻¹ = P := by
  funext k
  by_cases hk : k = i
  · rw [hk]
    simp only [conjAt, setAt]
    simp
    group
  · simp [conjAt, setAt, hk]

/-- Multiplying the `i`-th relator by the inverse of the `j`-th relator undoes
multiplication by the `j`-th relator. -/
theorem mulInvAt_mulAt {n : Nat} {i j : Fin n} (h : i ≠ j) (P : Presentation n) :
    mulInvAt (mulAt P i j) i j = P := by
  funext k
  by_cases hk : k = i
  · rw [hk]
    simp only [mulInvAt, mulAt, setAt]
    simp_all [Ne.symm h]
  · by_cases hk' : k = j
    · rw [hk']
      simp only [mulInvAt, mulAt, setAt]
      simp_all
    · simp only [mulInvAt, mulAt, setAt]
      simp_all

/-- Three moves carry `P` to `mulInvAt P i j`: invert `j`, multiply `i` by `j`,
invert `j` again. -/
theorem invertAt_mulAt_invertAt {n : Nat} {i j : Fin n} (h : i ≠ j) (P : Presentation n) :
    invertAt (mulAt (invertAt P j) i j) j = mulInvAt P i j := by
  funext k
  by_cases hk : k = j
  · rw [hk]
    simp only [invertAt, mulAt, mulInvAt, setAt]
    simp_all [Ne.symm h]
  · by_cases hk' : k = i
    · rw [hk']
      simp only [invertAt, mulAt, mulInvAt, setAt]
      simp_all
    · simp only [invertAt, mulAt, mulInvAt, setAt]
      simp_all

/-- Every AC move is reversed by a sequence of at most three AC moves. -/
theorem ACMove.toEquiv {P Q : Presentation n} (h : ACMove P Q) : ACEquiv Q P := by
  induction h with
  | invert i P =>
      have h2 : ACMove (invertAt P i) (invertAt (invertAt P i) i) :=
        ACMove.invert i (invertAt P i)
      rw [invertAt_involutive] at h2
      exact Relation.ReflTransGen.single h2
  | conj i w P =>
      have h2 : ACMove (conjAt P i w) (conjAt (conjAt P i w) i w⁻¹) :=
        ACMove.conj i w⁻¹ (conjAt P i w)
      rw [conjAt_undo] at h2
      exact Relation.ReflTransGen.single h2
  | mul i j hij P =>
      have s1 : ACMove (mulAt P i j) (invertAt (mulAt P i j) j) :=
        ACMove.invert j (mulAt P i j)
      have s2 : ACMove (invertAt (mulAt P i j) j) (mulAt (invertAt (mulAt P i j) j) i j) :=
        ACMove.mul i j hij (invertAt (mulAt P i j) j)
      have s3 : ACMove (mulAt (invertAt (mulAt P i j) j) i j)
          (invertAt (mulAt (invertAt (mulAt P i j) j) i j) j) :=
        ACMove.invert j (mulAt (invertAt (mulAt P i j) j) i j)
      have heq : invertAt (mulAt (invertAt (mulAt P i j) j) i j) j = P := by
        rw [invertAt_mulAt_invertAt hij, mulInvAt_mulAt hij]
      rw [heq] at s3
      exact Relation.ReflTransGen.trans (Relation.ReflTransGen.single s1)
        (Relation.ReflTransGen.trans (Relation.ReflTransGen.single s2)
          (Relation.ReflTransGen.single s3))

/-- AC-equivalence is symmetric. -/
theorem ACEquiv.symm {P Q : Presentation n} (h : ACEquiv P Q) : ACEquiv Q P := by
  induction h with
  | refl => exact ACEquiv.refl P
  | tail _ hstep ih => exact ACEquiv.trans (ACMove.toEquiv hstep) ih

/-- The derived move: multiply the `i`-th relator by the inverse of the `j`-th relator. -/
theorem ACEquiv.mulInv {n : Nat} {i j : Fin n} (h : i ≠ j) (P : Presentation n) :
    ACEquiv P (mulInvAt P i j) := by
  have s1 : ACEquiv P (invertAt P j) := Relation.ReflTransGen.single (ACMove.invert j P)
  have s2 : ACEquiv (invertAt P j) (mulAt (invertAt P j) i j) :=
    Relation.ReflTransGen.single (ACMove.mul i j h (invertAt P j))
  have s3 : ACEquiv (mulAt (invertAt P j) i j) (invertAt (mulAt (invertAt P j) i j) j) :=
    Relation.ReflTransGen.single (ACMove.invert j (mulAt (invertAt P j) i j))
  rw [invertAt_mulAt_invertAt h] at s3
  exact ACEquiv.trans s1 (ACEquiv.trans s2 s3)

/-! ## Two concrete presentations -/

/-- The standard balanced presentation of the trivial group at rank `n`:
the relators are the generators. -/
def standard (n : Nat) : Presentation n := fun i => FreeGroup.of i

/-- The Akbulut-Kirby presentation at `n = 3`, as a relator tuple:
`x y x (y x y)^-1` and `x^3 (y^4)^-1`, with `x = of 0` and `y = of 1`.
This is the rank-two balanced presentation `AK(3) = <x, y | xyx = yxy, x^3 = y^4>`
of Akbulut and Kirby, Topology 24 (1985), 375-390, DOI 10.1016/0040-9383(85)90010-2.
Whether this relator tuple is AC-equivalent to the standard one is open; it is a
standard candidate for a counterexample to the Andrews-Curtis conjecture.  This file
makes no claim about it beyond the two exponent-sum computations below. -/
def AK3 : Presentation 2 :=
  Fin.cases (FreeGroup.of 0 * FreeGroup.of 1 * FreeGroup.of 0 *
      (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹)
    (fun _ => FreeGroup.of 0 ^ 3 * (FreeGroup.of 1 ^ 4)⁻¹)

theorem AK3_zero :
    AK3 0 = FreeGroup.of 0 * FreeGroup.of 1 * FreeGroup.of 0 *
      (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹ := rfl

theorem AK3_one : AK3 1 = FreeGroup.of 0 ^ 3 * (FreeGroup.of 1 ^ 4)⁻¹ := rfl

theorem AK3_toList_length : AK3.toList.length = 2 := AK3.length_toList

/-! ## The abelian (exponent-sum) invariant -/

/-- The exponent-sum homomorphism: the `i`-th generator is sent to the `i`-th standard
basis vector of `Z^n`, written multiplicatively. -/
noncomputable def expSumHom (n : Nat) : Word n →* Multiplicative (Fin n → ℤ) :=
  FreeGroup.lift fun i => Multiplicative.ofAdd (Pi.single i (1 : ℤ))

/-- The exponent-sum vector of a word: its image under `expSumHom`, read additively. -/
noncomputable def expSumVec {n : Nat} (w : Word n) : Fin n → ℤ :=
  Multiplicative.toAdd (expSumHom n w)

@[simp] theorem expSumVec_one {n : Nat} : expSumVec (1 : Word n) = 0 := by
  simp [expSumVec]

@[simp] theorem expSumVec_mul {n : Nat} (u v : Word n) :
    expSumVec (u * v) = expSumVec u + expSumVec v := by
  simp [expSumVec]

@[simp] theorem expSumVec_inv {n : Nat} (u : Word n) : expSumVec u⁻¹ = -expSumVec u := by
  simp [expSumVec]

/-- The exponent sum of a generator is the corresponding standard basis vector. -/
@[simp] theorem expSumVec_of {n : Nat} (i : Fin n) :
    expSumVec (FreeGroup.of i) = (Pi.single i (1 : ℤ) : Fin n → ℤ) := by
  simp [expSumVec, expSumHom, FreeGroup.lift_apply_of]

/-- Conjugation does not change the exponent-sum vector. -/
theorem expSumVec_conj {n : Nat} (w r : Word n) :
    expSumVec (w * r * w⁻¹) = expSumVec r := by
  rw [expSumVec_mul, expSumVec_mul, expSumVec_inv]
  abel

/-- The `Z`-span in `Z^n` of the exponent-sum vectors of the relators of `P`. -/
noncomputable def abSpan {n : Nat} (P : Presentation n) : Submodule ℤ (Fin n → ℤ) :=
  Submodule.span ℤ (Set.range fun j => expSumVec (P j))

theorem expSumVec_mem_abSpan {n : Nat} (P : Presentation n) (j : Fin n) :
    expSumVec (P j) ∈ abSpan P :=
  Submodule.subset_span ⟨j, rfl⟩

theorem abSpan_le_of_forall_mem {n : Nat} {P Q : Presentation n}
    (h : ∀ j, expSumVec (Q j) ∈ abSpan P) : abSpan Q ≤ abSpan P := by
  rw [abSpan, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  exact h j

/-- Move 1 preserves the abelian span. -/
theorem abSpan_invertAt {n : Nat} (P : Presentation n) (i : Fin n) :
    abSpan (invertAt P i) = abSpan P := by
  have key : ∀ (R : Presentation n) (i : Fin n), abSpan (invertAt R i) ≤ abSpan R := by
    intro R i
    refine abSpan_le_of_forall_mem fun k => ?_
    by_cases hk : k = i
    · rw [hk]
      have hneg : -expSumVec (R i) ∈ abSpan R :=
        Submodule.neg_mem _ (expSumVec_mem_abSpan R i)
      simpa [invertAt, setAt] using hneg
    · have hsame : expSumVec (R k) ∈ abSpan R := expSumVec_mem_abSpan R k
      simpa [invertAt, setAt, hk, Ne.symm hk] using hsame
  refine le_antisymm (key P i) ?_
  calc abSpan P = abSpan (invertAt (invertAt P i) i) := by rw [invertAt_involutive]
    _ ≤ abSpan (invertAt P i) := key (invertAt P i) i

/-- Move 3 preserves the abelian span. -/
theorem abSpan_conjAt {n : Nat} (P : Presentation n) (i : Fin n) (w : Word n) :
    abSpan (conjAt P i w) = abSpan P := by
  have key : ∀ (R : Presentation n) (i : Fin n) (w : Word n),
      abSpan (conjAt R i w) ≤ abSpan R := by
    intro R i w
    refine abSpan_le_of_forall_mem fun k => ?_
    by_cases hk : k = i
    · rw [hk]
      have hsame : expSumVec (R i) ∈ abSpan R := expSumVec_mem_abSpan R i
      simpa [conjAt, setAt, expSumVec_conj] using hsame
    · have hsame : expSumVec (R k) ∈ abSpan R := expSumVec_mem_abSpan R k
      simpa [conjAt, setAt, hk, Ne.symm hk] using hsame
  refine le_antisymm (key P i w) ?_
  calc abSpan P = abSpan (conjAt (conjAt P i w) i w⁻¹) := by rw [conjAt_undo]
    _ ≤ abSpan (conjAt P i w) := key (conjAt P i w) i w⁻¹

/-- Move 2 preserves the abelian span. -/
theorem abSpan_mulAt {n : Nat} (P : Presentation n) {i j : Fin n} (h : i ≠ j) :
    abSpan (mulAt P i j) = abSpan P := by
  refine le_antisymm ?_ ?_
  · refine abSpan_le_of_forall_mem fun k => ?_
    by_cases hk : k = i
    · rw [hk]
      have hadd : expSumVec (P i) + expSumVec (P j) ∈ abSpan P :=
        Submodule.add_mem _ (expSumVec_mem_abSpan P i) (expSumVec_mem_abSpan P j)
      simpa [mulAt, setAt] using hadd
    · have hsame : expSumVec (P k) ∈ abSpan P := expSumVec_mem_abSpan P k
      simpa [mulAt, setAt, hk, Ne.symm hk] using hsame
  · refine abSpan_le_of_forall_mem fun k => ?_
    by_cases hki : k = i
    · rw [hki]
      have h1 : expSumVec (mulAt P i j i) ∈ abSpan (mulAt P i j) :=
        expSumVec_mem_abSpan (mulAt P i j) i
      have h2 : expSumVec (mulAt P i j j) ∈ abSpan (mulAt P i j) :=
        expSumVec_mem_abSpan (mulAt P i j) j
      have h1' : expSumVec (P i) + expSumVec (P j) ∈ abSpan (mulAt P i j) := by
        simpa [mulAt, setAt] using h1
      have h2' : expSumVec (P j) ∈ abSpan (mulAt P i j) := by
        simpa [mulAt, setAt, h, Ne.symm h] using h2
      have h3 := Submodule.sub_mem _ h1' h2'
      simpa using h3
    · by_cases hkj : k = j
      · rw [hkj]
        have h2 : expSumVec (mulAt P i j j) ∈ abSpan (mulAt P i j) :=
          expSumVec_mem_abSpan (mulAt P i j) j
        simpa [mulAt, setAt, h, Ne.symm h] using h2
      · have h3 : expSumVec (mulAt P i j k) ∈ abSpan (mulAt P i j) :=
          expSumVec_mem_abSpan (mulAt P i j) k
        simpa [mulAt, setAt, hki, hkj, Ne.symm hki, Ne.symm hkj] using h3

set_option maxHeartbeats 1000000 in
/-- Every AC move preserves the abelian span. -/
theorem abSpan_eq_of_acMove {P Q : Presentation n} (h : ACMove P Q) :
    abSpan P = abSpan Q := by
  induction h with
  | invert i P => exact (abSpan_invertAt P i).symm
  | mul i j hij P => exact (abSpan_mulAt P hij).symm
  | conj i w P => exact (abSpan_conjAt P i w).symm

set_option maxHeartbeats 1000000 in
/-- The abelian span is an invariant of AC-equivalence: two AC-equivalent presentations
have the same exponent-sum span.  Consequently, two presentations whose spans differ are
not AC-equivalent. -/
theorem abSpan_eq_of_acEquiv {P Q : Presentation n} (h : ACEquiv P Q) :
    abSpan P = abSpan Q := by
  induction h with
  | refl => rfl
  | tail _ hstep ih => exact ih.trans (abSpan_eq_of_acMove hstep)


/-! ## The exponent sum of a power, and the standard basis of `Z^n` -/

@[simp] theorem expSumVec_pow {n : Nat} (u : Word n) (k : Nat) :
    expSumVec (u ^ k) = k • expSumVec u := by
  simp [expSumVec]

/-- The decomposition of a vector of `Z^n` in the standard basis. -/
theorem eq_sum_smul_single {n : Nat} (x : Fin n → ℤ) :
    x = ∑ i : Fin n, x i • (Pi.single i (1 : ℤ) : Fin n → ℤ) := by
  ext k
  rw [Finset.sum_apply]
  simp only [Pi.smul_apply, smul_eq_mul]
  have h := Finset.sum_eq_single (s := Finset.univ)
      (f := fun i : Fin n => x i * (Pi.single i (1 : ℤ) : Fin n → ℤ) k) k
      (by
        intro i _ hik
        simp [Pi.single_eq_of_ne, Ne.symm hik])
      (by
        intro hk
        exact absurd (Finset.mem_univ k) hk)
  rw [h]
  simp

/-- If the exponent-sum span contains every standard basis vector, it is everything. -/
theorem abSpan_eq_top_of_single_mem {n : Nat} {P : Presentation n}
    (h : ∀ i, (Pi.single i (1 : ℤ) : Fin n → ℤ) ∈ abSpan P) : abSpan P = ⊤ := by
  refine Submodule.eq_top_iff'.mpr fun x => ?_
  rw [eq_sum_smul_single x]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (h i)

/-- The standard presentation has full exponent-sum span. -/
theorem abSpan_standard (n : Nat) : abSpan (standard n) = ⊤ := by
  refine abSpan_eq_top_of_single_mem fun i => ?_
  have h := expSumVec_mem_abSpan (standard n) i
  simpa [standard] using h

/-! ## The exponent-sum vectors of the Akbulut-Kirby relators -/

/-- The first AK(3) relator has exponent-sum vector `(1, -1)`. -/
theorem expSumVec_AK3_zero :
    expSumVec (AK3 0) =
      (Pi.single 0 (1 : ℤ) : Fin 2 → ℤ) - Pi.single 1 (1 : ℤ) := by
  rw [AK3_zero]
  simp only [expSumVec_mul, expSumVec_inv, expSumVec_of]
  abel

/-- The second AK(3) relator has exponent-sum vector `(3, -4)`. -/
theorem expSumVec_AK3_one :
    expSumVec (AK3 1) =
      3 • (Pi.single 0 (1 : ℤ) : Fin 2 → ℤ) - 4 • Pi.single 1 (1 : ℤ) := by
  rw [AK3_one]
  simp only [expSumVec_mul, expSumVec_inv, expSumVec_pow, expSumVec_of]
  abel

/-- AK(3) has full exponent-sum span: its exponent-sum matrix `!![1, -1; 3, -4]`
has determinant `-1`, which is a unit of `Z`. -/
theorem abSpan_AK3 : abSpan AK3 = ⊤ := by
  refine abSpan_eq_top_of_single_mem fun i => ?_
  have h1 := expSumVec_mem_abSpan AK3 0
  have h2 := expSumVec_mem_abSpan AK3 1
  fin_cases i
  · have h : (4 : ℤ) • expSumVec (AK3 0) - expSumVec (AK3 1) ∈ abSpan AK3 :=
      Submodule.sub_mem _ (Submodule.smul_mem _ 4 h1) h2
    have heq : (4 : ℤ) • expSumVec (AK3 0) - expSumVec (AK3 1) =
        (Pi.single 0 (1 : ℤ) : Fin 2 → ℤ) := by
      rw [expSumVec_AK3_zero, expSumVec_AK3_one]
      abel
    rw [heq] at h
    exact h
  · have h : (3 : ℤ) • expSumVec (AK3 0) - expSumVec (AK3 1) ∈ abSpan AK3 :=
      Submodule.sub_mem _ (Submodule.smul_mem _ 3 h1) h2
    have heq : (3 : ℤ) • expSumVec (AK3 0) - expSumVec (AK3 1) =
        (Pi.single 1 (1 : ℤ) : Fin 2 → ℤ) := by
      rw [expSumVec_AK3_zero, expSumVec_AK3_one]
      abel
    rw [heq] at h
    exact h

/-- The abelian invariant does not separate AK(3) from the standard presentation:
both have full exponent-sum span.  This is the precise sense in which the abelian
invariant cannot decide the Andrews-Curtis conjecture. -/
theorem abSpan_AK3_eq_abSpan_standard : abSpan AK3 = abSpan (standard 2) := by
  rw [abSpan_AK3, abSpan_standard]

/-- If the exponent-sum spans differ, the two presentations are not AC-equivalent. -/
theorem not_acEquiv_of_abSpan_ne {P Q : Presentation n} (h : abSpan P ≠ abSpan Q) :
    ¬ ACEquiv P Q := fun hc => h (abSpan_eq_of_acEquiv hc)


/-! ## A derived move: left multiplication by another relator -/

/-- Left multiplication by another relator is available: conjugate `r i` by `r j` and
then multiply by `r j` on the right. -/
theorem ACEquiv.mulLeft {n : Nat} {i j : Fin n} (h : i ≠ j) (P : Presentation n) :
    ACEquiv P (setAt P i (P j * P i)) := by
  have s1 : ACEquiv P (conjAt P i (P j)) :=
    Relation.ReflTransGen.single (ACMove.conj i (P j) P)
  have s2 : ACEquiv (conjAt P i (P j)) (mulAt (conjAt P i (P j)) i j) :=
    Relation.ReflTransGen.single (ACMove.mul i j h (conjAt P i (P j)))
  have heq : mulAt (conjAt P i (P j)) i j = setAt P i (P j * P i) := by
    funext k
    by_cases hk : k = i
    · rw [hk]
      simp only [mulAt, conjAt, setAt]
      simp_all
    · simp only [mulAt, conjAt, setAt]
      simp_all
  rw [heq] at s2
  exact ACEquiv.trans s1 s2

/-! ## A genuine non-equivalence detected by the invariant -/

/-- The rank-one presentation with the single relator `x^2`.  It presents the cyclic
group of order two, so it is not a presentation of the trivial group.  It is used here
only to show that the invariant of this file does detect non-equivalences. -/
def rankOneSq : Presentation 1 := fun _ => FreeGroup.of 0 ^ 2

theorem abSpan_rankOneSq :
    abSpan rankOneSq =
      Submodule.span ℤ {((2 : ℤ) • (Pi.single 0 (1 : ℤ) : Fin 1 → ℤ))} := by
  rw [abSpan]
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    have hi : i = 0 := Subsingleton.elim i 0
    rw [hi]
    simp [rankOneSq]
  · rintro rfl
    exact ⟨0, by simp [rankOneSq]⟩

theorem single_not_mem_two :
    (Pi.single 0 (1 : ℤ) : Fin 1 → ℤ) ∉
      Submodule.span ℤ {((2 : ℤ) • (Pi.single 0 (1 : ℤ) : Fin 1 → ℤ))} := by
  intro h
  rw [Submodule.mem_span_singleton] at h
  obtain ⟨a, ha⟩ := h
  have h0 := congrFun ha 0
  simp at h0
  omega

/-- The standard rank-one presentation `x` and the presentation `x^2` are not
AC-equivalent.  This is the invariant at work; it is outside the setting of the
conjecture, where both sides must present the trivial group. -/
theorem not_acEquiv_standard_rankOneSq : ¬ ACEquiv (standard 1) rankOneSq := by
  refine not_acEquiv_of_abSpan_ne ?_
  rw [abSpan_standard, abSpan_rankOneSq]
  intro htop
  have hmem : (Pi.single 0 (1 : ℤ) : Fin 1 → ℤ) ∈
      Submodule.span ℤ {((2 : ℤ) • (Pi.single 0 (1 : ℤ) : Fin 1 → ℤ))} := by
    rw [← htop]
    exact Submodule.mem_top
  exact single_not_mem_two hmem

